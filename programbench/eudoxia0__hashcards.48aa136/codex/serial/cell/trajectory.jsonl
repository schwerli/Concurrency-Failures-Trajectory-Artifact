{"type":"item.started","item":{"id":"item_177","type":"command_execution","command":"/bin/bash -lc 'tmpdir=$(mktemp -d /workspace/hashprobe-XXXXXX)\ncd \"$tmpdir\"\ncat > Cargo.toml <<'\"'EOF'\n[package]\nname = \\\"hashprobe\\\"\nversion = \\\"0.1.0\\\"\nedition = \\\"2021\\\"\n\n[dependencies]\nserde = { version = \\\"1\\\", features = [\\\"derive\\\"] }\nbincode = \\\"1\\\"\npostcard = { version = \\\"1\\\", features = [\\\"use-std\\\"] }\nsha2 = \\\"0.10\\\"\nblake3 = \\\"1\\\"\nserde_json = \\\"1\\\"\nrmp-serde = \\\"1\\\"\nEOF\nmkdir src\ncat > src/main.rs <<'EOF'\nuse serde::Serialize;\nuse sha2::{Digest, Sha256};\n\nfn sha256_hex(bytes: &[u8]) -> String {\n    let mut hasher = Sha256::new();\n    hasher.update(bytes);\n    format\"'!(\"{:x}\", hasher.finalize())\n}\n\nfn blake3_hex(bytes: &[u8]) -> String {\n    blake3::hash(bytes).to_hex().to_string()\n}\n\n#[derive(Serialize)]\nstruct BasicCard { question: String, answer: String }\n#[derive(Serialize)]\nenum CardContentTuple { Basic(BasicCard), Cloze(ClozeCard) }\n#[derive(Serialize)]\nenum CardContentStruct {\n    Basic { question: String, answer: String },\n    Cloze { text: String, start: usize, end: usize },\n}\n#[derive(Serialize)]\nstruct ClozeCard { text: String, start: usize, end: usize }\n#[derive(Serialize)]\nstruct TextOnly { text: String }\n\nfn show<T: Serialize>(label: &str, value: &T) {\n    let json = serde_json::to_vec(value).unwrap();\n    let bin = bincode::serialize(value).unwrap();\n    let post = postcard::to_allocvec(value).unwrap();\n    let msg = rmp_serde::to_vec(value).unwrap();\n    println!(\"{label} json sha {}\", sha256_hex(&json));\n    println!(\"{label} json bl3 {}\", blake3_hex(&json));\n    println!(\"{label} bin sha {}\", sha256_hex(&bin));\n    println!(\"{label} bin bl3 {}\", blake3_hex(&bin));\n    println!(\"{label} post sha {}\", sha256_hex(&post));\n    println!(\"{label} post bl3 {}\", blake3_hex(&post));\n    println!(\"{label} msg sha {}\", sha256_hex(&msg));\n    println!(\"{label} msg bl3 {}\", blake3_hex(&msg));\n}\n\nfn main() {\n    let basic = BasicCard { question: \"x\".into(), answer: \"y\".into() };\n    let basic_tuple = CardContentTuple::Basic(BasicCard { question: \"x\".into(), answer: \"y\".into() });\n    let basic_struct = CardContentStruct::Basic { question: \"x\".into(), answer: \"y\".into() };\n    let cloze = ClozeCard { text: \"foo bar\".into(), start: 0, end: 2 };\n    let cloze_tuple = CardContentTuple::Cloze(ClozeCard { text: \"foo bar\".into(), start: 0, end: 2 });\n    let cloze_struct = CardContentStruct::Cloze { text: \"foo bar\".into(), start: 0, end: 2 };\n    let text_only = TextOnly { text: \"foo bar\".into() };\n    show(\"basic\", &basic);\n    show(\"basic_tuple\", &basic_tuple);\n    show(\"basic_struct\", &basic_struct);\n    show(\"cloze\", &cloze);\n    show(\"cloze_tuple\", &cloze_tuple);\n    show(\"cloze_struct\", &cloze_struct);\n    show(\"text_only\", &text_only);\n    println!(\"str sha {}\", sha256_hex(\"foo bar\".as_bytes()));\n    println!(\"str bl3 {}\", blake3_hex(\"foo bar\".as_bytes()));\n}\nEOF\ncargo run -q'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
