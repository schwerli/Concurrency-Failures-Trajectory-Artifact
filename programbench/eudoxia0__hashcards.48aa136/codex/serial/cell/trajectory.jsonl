{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os, subprocess, tempfile, shutil, time, urllib.request, re\nbase='/workspace/example'\nresults=[]\nports=range(8020,8025)\nfor port in ports:\n    tmp=tempfile.mkdtemp(prefix='probe-quotes-', dir='/workspace')\n    shutil.copytree(base, tmp, dirs_exist_ok=True)\n    db=os.path.join(tmp,'hashcards.db')\n    if os.path.exists(db): os.unlink(db)\n    p=subprocess.Popen(['/workspace/executable','drill',tmp,'--open-browser','false','--port',str(port),'--from-deck','Quotes'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n    time.sleep(0.5)\n    try:\n        html=urllib.request.urlopen(f'http://127.0.0.1:{port}/').read().decode()\n        m=re.search(r\\\"<span class='cloze'>(.*?)</span>\\\", html)\n        if not m:\n            m=re.search(r\\\"<span class='cloze-reveal'>(.*?)</span>\\\", html)\n        results.append((port,m.group(1) if m else 'none'))\n        subprocess.run(['curl','-s','-X','POST','-d','action=Shutdown',f'http://127.0.0.1:{port}/'], stdout=subprocess.DEVNULL)\n        p.wait(timeout=2)\n    finally:\n        if p.poll() is None:\n            p.kill()\nprint(results)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
