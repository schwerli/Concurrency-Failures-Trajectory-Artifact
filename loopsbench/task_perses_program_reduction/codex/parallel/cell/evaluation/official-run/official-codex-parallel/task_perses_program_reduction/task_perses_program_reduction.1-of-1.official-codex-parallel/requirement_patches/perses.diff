+import unittest
+
+from reduction.driver import ReductionDriver
+from reduction.grammar import Grammar, GrammarRule, RuleType
+from reduction.perses_reducer import PersesReducer
+from reduction.pnf import normalize_to_pnf
+
+
+class ZeroDivisionTester:
+    def __init__(self) -> None:
+        self._test_count = 0
+
+    @property
+    def test_count(self) -> int:
+        return self._test_count
+
+    def test(self, source: str) -> bool:
+        self._test_count += 1
+        namespace: dict[str, object] = {}
+        try:
+            exec(source, namespace, namespace)
+        except ZeroDivisionError:
+            return True
+        except Exception:
+            return False
+        return False
+
+
+class PNFNormalizerTest(unittest.TestCase):
+    def test_normalizer_prunes_unreachable_and_rewrites_recursion(self) -> None:
+        grammar = Grammar(start_symbol="start")
+        grammar.add_rule(GrammarRule("start", RuleType.SEQUENCE, ["alias"]))
+        grammar.add_rule(GrammarRule("alias", RuleType.ALTERNATION, ["expr"]))
+        grammar.add_rule(GrammarRule("expr", RuleType.SEQUENCE, ["expr", "TERM"]))
+        grammar.add_rule(GrammarRule("dead", RuleType.SEQUENCE, ["GHOST"]))
+
+        normalized = normalize_to_pnf(grammar)
+
+        self.assertNotIn("dead", normalized.rules)
+        self.assertNotIn("alias", normalized.rules)
+        self.assertEqual(len(normalized.rules), 1)
+        self.assertEqual(normalized.rules[normalized.start_symbol].rule_type, RuleType.KLEENE_PLUS)
+        self.assertTrue(normalized.is_pnf())
+
+
+class PersesReducerTest(unittest.TestCase):
+    def test_reducer_removes_irrelevant_subtrees(self) -> None:
+        source = """\
+def helper():
+    return 1
+
+def trigger():
+    x = helper()
+    return 1 / 0
+
+trigger()
+"""
+        grammar = normalize_to_pnf(Grammar.python_simplified())
+        tester = ZeroDivisionTester()
+        driver = ReductionDriver(grammar, tester, [PersesReducer(grammar)])
+
+        result = driver.reduce(source)
+
+        self.assertLess(result.reduced_tokens, result.original_tokens)
+        self.assertIn("trigger", result.reduced_source)
+        self.assertTrue(ZeroDivisionTester().test(result.reduced_source))
+
+
+if __name__ == "__main__":
+    unittest.main()
