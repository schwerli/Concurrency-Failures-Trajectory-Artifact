+++ b/reduction/perses_reducer.py
@@ -0,0 +1,266 @@
+"""Perses-style syntax-guided reducer."""
+
+from __future__ import annotations
+
+import heapq
+
+from reduction.grammar import Grammar, RuleType
+from reduction.parser import Parser
+from reduction.pnf import normalize_to_pnf
+from reduction.property_test import PropertyTester
+from reduction.reducer import AbstractReducer
+from reduction.tree import NodeType, SparTreeNode
+from reduction.tree_utils import iter_nodes, node_at, parent_at
+
+
+LIST_RULE_TYPES = {RuleType.KLEENE_STAR, RuleType.KLEENE_PLUS}
+
+
+class PersesReducer(AbstractReducer):
+    """Reduce a SparTree while preserving grammar-compatible structure."""
+
+    def __init__(self, grammar: Grammar):
+        self.grammar = normalize_to_pnf(grammar)
+        self.parser = Parser(self.grammar)
+
+    @property
+    def name(self) -> str:
+        return "perses"
+
+    def reduce(self, tree: SparTreeNode, tester: PropertyTester) -> SparTreeNode:
+        working = self.parser.parse(tree.to_source())
+
+        while True:
+            candidate = self._reduce_once(working, tester)
+            if candidate is None or candidate.token_count() >= working.token_count():
+                return working
+            working = candidate
+
+    def _reduce_once(
+        self,
+        tree: SparTreeNode,
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        queue: list[tuple[int, int, tuple[int, ...]]] = []
+        for order, (path, node) in enumerate(iter_nodes(tree)):
+            if node.deleted or node.node_type == NodeType.TOKEN or node.token_count() == 0:
+                continue
+            heapq.heappush(queue, (-node.token_count(), order, path))
+
+        while queue:
+            _, _, path = heapq.heappop(queue)
+            node = node_at(tree, path)
+            if node is None or node.deleted or node.token_count() == 0:
+                continue
+
+            if self._is_list_node(node):
+                candidate = self._reduce_list_children(tree, path, tester)
+            elif node.node_type == NodeType.OPTIONAL:
+                candidate = self._delete_whole_node(tree, path, tester)
+            elif node.node_type == NodeType.REGULAR:
+                candidate = self._replace_with_compatible_descendant(tree, path, tester)
+            else:
+                candidate = None
+
+            if candidate is not None and candidate.token_count() < tree.token_count():
+                return candidate
+
+        return None
+
+    def _is_list_node(self, node: SparTreeNode) -> bool:
+        rule = self.grammar.expected_rule(node.rule_name)
+        return rule is not None and rule.rule_type in LIST_RULE_TYPES
+
+    def _reduce_list_children(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        working = tree
+        rule = self.grammar.expected_rule(node_at(tree, path).rule_name) if node_at(tree, path) else None
+        if rule is None:
+            return None
+
+        minimum_children = 1 if rule.rule_type == RuleType.KLEENE_PLUS else 0
+        granularity = 2
+        changed = False
+
+        while True:
+            node = node_at(working, path)
+            if node is None or len(node.children) <= minimum_children:
+                break
+
+            partitions = self._split_indices(len(node.children), granularity)
+            progress = False
+
+            for partition in partitions:
+                keep = [index for index in range(len(node.children)) if index not in partition]
+                if len(keep) < minimum_children:
+                    continue
+                candidate = self._clone_with_child_subset(working, path, keep)
+                accepted = self._accept_tree(candidate, tester)
+                if accepted is not None:
+                    working = accepted
+                    granularity = max(2, granularity - 1)
+                    changed = True
+                    progress = True
+                    break
+
+            if progress:
+                continue
+
+            for partition in partitions:
+                if len(partition) < minimum_children or len(partition) == len(node.children):
+                    continue
+                candidate = self._clone_with_child_subset(working, path, partition)
+                accepted = self._accept_tree(candidate, tester)
+                if accepted is not None:
+                    working = accepted
+                    granularity = 2
+                    changed = True
+                    progress = True
+                    break
+
+            if progress:
+                continue
+
+            if granularity >= len(node.children):
+                break
+            granularity = min(len(node.children), granularity * 2)
+
+        if changed:
+            return working
+        return None
+
+    def _delete_whole_node(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        if not path:
+            return None
+        candidate = tree.clone()
+        parent, index = parent_at(candidate, path)
+        if parent is None or index is None:
+            return None
+        del parent.children[index]
+        return self._accept_tree(candidate, tester)
+
+    def _replace_with_compatible_descendant(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        if not path:
+            return None
+
+        target = node_at(tree, path)
+        if target is None or target.token_count() <= 1:
+            return None
+
+        seen_sources: set[str] = set()
+        for candidate_node in sorted(
+            self._compatible_descendants(target),
+            key=lambda item: item.token_count(),
+        ):
+            candidate_source = candidate_node.to_source()
+            if candidate_source in seen_sources:
+                continue
+            seen_sources.add(candidate_source)
+
+            candidate_tree = tree.clone()
+            parent, index = parent_at(candidate_tree, path)
+            if parent is None or index is None:
+                continue
+            parent.children[index] = candidate_node.clone()
+            accepted = self._accept_tree(candidate_tree, tester)
+            if accepted is not None:
+                return accepted
+
+        return None
+
+    def _compatible_descendants(self, node: SparTreeNode) -> list[SparTreeNode]:
+        target_indent = self._leading_indent(node)
+        target_source = node.to_source()
+        candidates: list[SparTreeNode] = []
+
+        for _, descendant in iter_nodes(node):
+            if descendant is node or descendant.deleted:
+                continue
+            if descendant.rule_name != node.rule_name:
+                continue
+            if descendant.token_count() >= node.token_count():
+                continue
+            if self._leading_indent(descendant) != target_indent:
+                continue
+            if descendant.to_source() == target_source:
+                continue
+            candidates.append(descendant)
+
+        return candidates
+
+    def _clone_with_child_subset(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        keep_indices: list[int],
+    ) -> SparTreeNode:
+        candidate = tree.clone()
+        node = node_at(candidate, path)
+        if node is None:
+            return candidate
+        keep = set(keep_indices)
+        node.children = [
+            child
+            for index, child in enumerate(node.children)
+            if index in keep
+        ]
+        return candidate
+
+    def _accept_tree(
+        self,
+        candidate: SparTreeNode,
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        source = candidate.to_source()
+        if not source.strip():
+            return None
+        if not tester.test(source):
+            return None
+        return self.parser.parse(source)
+
+    def _leading_indent(self, node: SparTreeNode) -> int:
+        tokens = node.tokens()
+        if not tokens:
+            return 0
+
+        first_line = None
+        for token in tokens:
+            if token.type == "NEWLINE":
+                continue
+            if first_line is None:
+                first_line = token.line
+            if token.line != first_line:
+                break
+            if token.type == "INDENT":
+                return len(token.value)
+        return 0
+
+    def _split_indices(self, length: int, partitions: int) -> list[list[int]]:
+        if length <= 0:
+            return []
+        if partitions > length:
+            partitions = length
+
+        result = []
+        base = length // partitions
+        remainder = length % partitions
+        start = 0
+        for index in range(partitions):
+            end = start + base + (1 if index < remainder else 0)
+            result.append(list(range(start, end)))
+            start = end
+        return [chunk for chunk in result if chunk]
