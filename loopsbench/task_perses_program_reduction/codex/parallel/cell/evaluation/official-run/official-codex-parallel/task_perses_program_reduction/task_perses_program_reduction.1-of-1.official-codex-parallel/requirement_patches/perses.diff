+def render_tokens(tokens: List[Token]) -> str:
+    """Render a token stream back into source code.
+
+    The parser keeps tokens in structural order, so rendering follows that order
+    and uses the stored line/column positions only as soft spacing hints. This
+    remains stable even after subtree replacement, where absolute line numbers
+    from the original source are no longer globally meaningful.
+    """
+    if not tokens:
+        return ""
+
+    pieces: list[str] = []
+    prev: Token | None = None
+    at_line_start = True
+
+    for tok in tokens:
+        if tok.type == 'NEWLINE':
+            continue
+
+        line_changed = prev is not None and tok.line != prev.line
+        if line_changed:
+            pieces.append("\n")
+            at_line_start = True
+
+        if tok.type == 'INDENT':
+            if at_line_start:
+                pieces.append(tok.value)
+            elif pieces and not pieces[-1].endswith((" ", "\n")):
+                pieces.append(" ")
+                pieces.append(tok.value)
+            else:
+                pieces.append(tok.value)
+            at_line_start = False
+            prev = tok
+            continue
+
+        if not at_line_start:
+            gap = 0
+            if prev is not None and not line_changed:
+                gap = max(0, tok.col - (prev.col + len(prev.value)))
+            if gap > 0:
+                pieces.append(" " * gap)
+            elif pieces and not pieces[-1].endswith((" ", "\n")):
+                pieces.append(" ")
+
+        pieces.append(tok.value)
+        at_line_start = False
+        prev = tok
+
+    if not pieces or pieces[-1] != "\n":
+        pieces.append("\n")
+
+    return "".join(pieces)
+
