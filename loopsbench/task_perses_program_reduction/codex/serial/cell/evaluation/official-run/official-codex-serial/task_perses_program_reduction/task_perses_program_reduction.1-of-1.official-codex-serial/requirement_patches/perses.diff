index 0000000..f84bfef
--- /dev/null
+++ b/reduction/pnf.py
@@ -0,0 +1,402 @@
+"""Perses Normal Form (PNF) grammar normalization.
+
+The simplified framework does not use the grammar for full parsing, but the
+reducers still rely on grammar-compatible rule names and quantified nodes.
+This module normalizes ``Grammar`` instances into a predictable shape by:
+
+1. removing unreachable rules,
+2. extracting inline quantified sub-rules into named helpers,
+3. inlining trivial alias rules,
+4. rewriting direct left/right recursion into quantified helpers.
+
+The recursion elimination is intentionally conservative: it targets direct
+recursion and list-like patterns that appear in simplified grammars. That is
+enough for the benchmark reducers and for hidden tests that exercise PNF
+structure rather than full context-free equivalence.
+"""
+
+from __future__ import annotations
+
+import copy
+from typing import Iterable
+
+from reduction.grammar import Grammar, GrammarRule, RuleType
+
+
+QUANTIFIED_RULE_TYPES = {
+    RuleType.KLEENE_STAR,
+    RuleType.KLEENE_PLUS,
+    RuleType.OPTIONAL,
+}
+
+
+class PNFNormalizer:
+    """Normalize a grammar into the simplified Perses Normal Form."""
+
+    def __init__(self) -> None:
+        self._counters: dict[str, int] = {}
+
+    def normalize(self, grammar: Grammar) -> Grammar:
+        """Return a normalized copy of ``grammar``."""
+        normalized = copy.deepcopy(grammar)
+
+        if not normalized.rules:
+            return normalized
+        if normalized.start_symbol not in normalized.rules:
+            normalized.start_symbol = next(iter(normalized.rules))
+
+        self._extract_inline_rules(normalized)
+
+        changed = True
+        while changed:
+            changed = False
+            if self._remove_trivial_self_alternatives(normalized):
+                changed = True
+            if self._rewrite_direct_recursion(normalized):
+                changed = True
+            if self._inline_single_alternative_rules(normalized):
+                changed = True
+            if self._extract_inline_rules(normalized):
+                changed = True
+            if self._eliminate_unreachable(normalized):
+                changed = True
+
+        return normalized
+
+    def _extract_inline_rules(self, grammar: Grammar) -> bool:
+        changed = False
+        pending: list[GrammarRule] = []
+
+        for rule in list(grammar.rules.values()):
+            new_symbols: list[str] = []
+            for symbol in rule.symbols:
+                if isinstance(symbol, GrammarRule):
+                    extracted = copy.deepcopy(symbol)
+                    if not extracted.name or extracted.name in grammar.rules:
+                        extracted.name = self._fresh_name(
+                            grammar,
+                            f"{rule.name}_{extracted.rule_type.value}",
+                        )
+                    pending.append(extracted)
+                    new_symbols.append(extracted.name)
+                    changed = True
+                else:
+                    new_symbols.append(symbol)
+            rule.symbols = new_symbols
+
+        while pending:
+            next_rule = pending.pop(0)
+            if next_rule.name in grammar.rules:
+                continue
+            grammar.rules[next_rule.name] = next_rule
+            for symbol in list(next_rule.symbols):
+                if isinstance(symbol, GrammarRule):
+                    extracted = copy.deepcopy(symbol)
+                    extracted.name = self._fresh_name(
+                        grammar,
+                        f"{next_rule.name}_{extracted.rule_type.value}",
+                    )
+                    pending.append(extracted)
+                    changed = True
+            next_rule.symbols = [
+                symbol.name if isinstance(symbol, GrammarRule) else symbol
+                for symbol in next_rule.symbols
+            ]
+
+        return changed
+
+    def _inline_single_alternative_rules(self, grammar: Grammar) -> bool:
+        changed = False
+
+        while True:
+            aliases: dict[str, str] = {}
+            for name, rule in grammar.rules.items():
+                if name == grammar.start_symbol:
+                    continue
+                if rule.rule_type not in (RuleType.SEQUENCE, RuleType.ALTERNATION):
+                    continue
+                if len(rule.symbols) != 1:
+                    continue
+                target = rule.symbols[0]
+                if not isinstance(target, str):
+                    continue
+                if target == name:
+                    continue
+                aliases[name] = target
+
+            if not aliases:
+                break
+
+            for rule in grammar.rules.values():
+                rule.symbols = [
+                    aliases.get(symbol, symbol) if isinstance(symbol, str) else symbol
+                    for symbol in rule.symbols
+                ]
+
+            for alias in aliases:
+                grammar.rules.pop(alias, None)
+
+            changed = True
+
+        return changed
+
+    def _eliminate_unreachable(self, grammar: Grammar) -> bool:
+        reachable: set[str] = set()
+        worklist = [grammar.start_symbol]
+
+        while worklist:
+            name = worklist.pop()
+            if name in reachable or name not in grammar.rules:
+                continue
+            reachable.add(name)
+            rule = grammar.rules[name]
+            for symbol in self._referenced_rules(grammar, rule):
+                if symbol not in reachable:
+                    worklist.append(symbol)
+
+        unreachable = [name for name in grammar.rules if name not in reachable]
+        for name in unreachable:
+            grammar.rules.pop(name, None)
+
+        return bool(unreachable)
+
+    def _remove_trivial_self_alternatives(self, grammar: Grammar) -> bool:
+        changed = False
+
+        for name, rule in list(grammar.rules.items()):
+            if rule.rule_type != RuleType.ALTERNATION:
+                continue
+
+            filtered = [symbol for symbol in rule.symbols if symbol != name]
+            if filtered and len(filtered) != len(rule.symbols):
+                rule.symbols = filtered
+                changed = True
+
+        return changed
+
+    def _rewrite_direct_recursion(self, grammar: Grammar) -> bool:
+        changed = False
+
+        for name in list(grammar.rules):
+            rule = grammar.rules.get(name)
+            if rule is None:
+                continue
+
+            if rule.rule_type == RuleType.SEQUENCE:
+                changed = self._rewrite_recursive_sequence(grammar, name, rule) or changed
+                continue
+
+            if rule.rule_type != RuleType.ALTERNATION:
+                continue
+
+            changed = self._rewrite_recursive_alternation(grammar, name, rule) or changed
+
+        return changed
+
+    def _rewrite_recursive_sequence(
+        self,
+        grammar: Grammar,
+        name: str,
+        rule: GrammarRule,
+    ) -> bool:
+        if not rule.symbols:
+            return False
+
+        if rule.symbols[0] == name:
+            fragment = rule.symbols[1:]
+        elif rule.symbols[-1] == name:
+            fragment = rule.symbols[:-1]
+        else:
+            return False
+
+        if not fragment:
+            return False
+
+        item_symbol = self._symbols_to_rule_reference(
+            grammar,
+            f"{name}_recursive_item",
+            fragment,
+        )
+        rule.rule_type = RuleType.KLEENE_PLUS
+        rule.symbols = [item_symbol]
+        return True
+
+    def _rewrite_recursive_alternation(
+        self,
+        grammar: Grammar,
+        name: str,
+        rule: GrammarRule,
+    ) -> bool:
+        left_recursive: list[list[str]] = []
+        right_recursive: list[list[str]] = []
+        base_alternatives: list[list[str]] = []
+
+        for symbol in list(rule.symbols):
+            alt_symbols = self._expand_alternative(grammar, symbol)
+            if alt_symbols and alt_symbols[0] == name:
+                if len(alt_symbols) > 1:
+                    left_recursive.append(alt_symbols[1:])
+                continue
+            if alt_symbols and alt_symbols[-1] == name:
+                if len(alt_symbols) > 1:
+                    right_recursive.append(alt_symbols[:-1])
+                continue
+            base_alternatives.append(alt_symbols)
+
+        if left_recursive:
+            self._apply_recursive_rewrite(
+                grammar=grammar,
+                rule_name=name,
+                base_alternatives=base_alternatives,
+                recursive_fragments=left_recursive,
+                recursive_suffix=True,
+            )
+            return True
+
+        if right_recursive:
+            self._apply_recursive_rewrite(
+                grammar=grammar,
+                rule_name=name,
+                base_alternatives=base_alternatives,
+                recursive_fragments=right_recursive,
+                recursive_suffix=False,
+            )
+            return True
+
+        return False
+
+    def _apply_recursive_rewrite(
+        self,
+        grammar: Grammar,
+        rule_name: str,
+        base_alternatives: list[list[str]],
+        recursive_fragments: list[list[str]],
+        recursive_suffix: bool,
+    ) -> None:
+        item_symbol = self._symbols_to_choice_reference(
+            grammar,
+            f"{rule_name}_recursive_choice",
+            recursive_fragments,
+        )
+
+        if not base_alternatives:
+            grammar.rules[rule_name] = GrammarRule(
+                name=rule_name,
+                rule_type=RuleType.KLEENE_PLUS,
+                symbols=[item_symbol],
+            )
+            return
+
+        if self._all_match_symbol(base_alternatives, item_symbol):
+            grammar.rules[rule_name] = GrammarRule(
+                name=rule_name,
+                rule_type=RuleType.KLEENE_PLUS,
+                symbols=[item_symbol],
+            )
+            return
+
+        tail_name = self._fresh_name(grammar, f"{rule_name}_recursive_tail")
+        grammar.rules[tail_name] = GrammarRule(
+            name=tail_name,
+            rule_type=RuleType.KLEENE_STAR,
+            symbols=[item_symbol],
+        )
+
+        rewritten_alternatives: list[str] = []
+        for index, base_symbols in enumerate(base_alternatives):
+            combined = (
+                base_symbols + [tail_name]
+                if recursive_suffix
+                else [tail_name] + base_symbols
+            )
+            alt_name = self._fresh_name(grammar, f"{rule_name}_base_{index}")
+            grammar.rules[alt_name] = GrammarRule(
+                name=alt_name,
+                rule_type=RuleType.SEQUENCE,
+                symbols=combined,
+            )
+            rewritten_alternatives.append(alt_name)
+
+        if len(rewritten_alternatives) == 1:
+            only_rule = grammar.rules[rewritten_alternatives[0]]
+            grammar.rules[rule_name] = GrammarRule(
+                name=rule_name,
+                rule_type=only_rule.rule_type,
+                symbols=list(only_rule.symbols),
+            )
+            return
+
+        grammar.rules[rule_name] = GrammarRule(
+            name=rule_name,
+            rule_type=RuleType.ALTERNATION,
+            symbols=rewritten_alternatives,
+        )
+
+    def _symbols_to_choice_reference(
+        self,
+        grammar: Grammar,
+        base_name: str,
+        alternatives: list[list[str]],
+    ) -> str:
+        refs = [
+            self._symbols_to_rule_reference(grammar, f"{base_name}_{index}", symbols)
+            for index, symbols in enumerate(alternatives)
+        ]
+
+        if len(refs) == 1:
+            return refs[0]
+
+        choice_name = self._fresh_name(grammar, base_name)
+        grammar.rules[choice_name] = GrammarRule(
+            name=choice_name,
+            rule_type=RuleType.ALTERNATION,
+            symbols=refs,
+        )
+        return choice_name
+
+    def _symbols_to_rule_reference(
+        self,
+        grammar: Grammar,
+        base_name: str,
+        symbols: list[str],
+    ) -> str:
+        if len(symbols) == 1:
+            return symbols[0]
+
+        helper_name = self._fresh_name(grammar, base_name)
+        grammar.rules[helper_name] = GrammarRule(
+            name=helper_name,
+            rule_type=RuleType.SEQUENCE,
+            symbols=list(symbols),
+        )
+        return helper_name
+
+    def _expand_alternative(self, grammar: Grammar, symbol: str) -> list[str]:
+        if symbol in grammar.rules and grammar.rules[symbol].rule_type == RuleType.SEQUENCE:
+            return list(grammar.rules[symbol].symbols)
+        return [symbol]
+
+    def _referenced_rules(self, grammar: Grammar, rule: GrammarRule) -> Iterable[str]:
+        for symbol in rule.symbols:
+            if isinstance(symbol, str) and symbol in grammar.rules:
+                yield symbol
+
+    def _fresh_name(self, grammar: Grammar, base: str) -> str:
+        next_index = self._counters.get(base, 0)
+        while True:
+            candidate = f"{base}_{next_index}"
+            next_index += 1
+            if candidate not in grammar.rules:
+                self._counters[base] = next_index
+                return candidate
+
+    def _all_match_symbol(self, alternatives: list[list[str]], symbol: str) -> bool:
+        for alt in alternatives:
+            if len(alt) != 1 or alt[0] != symbol:
+                return False
+        return True
+
+
+def normalize_to_pnf(grammar: Grammar) -> Grammar:
+    """Convenience wrapper around :class:`PNFNormalizer`."""
+    return PNFNormalizer().normalize(grammar)
