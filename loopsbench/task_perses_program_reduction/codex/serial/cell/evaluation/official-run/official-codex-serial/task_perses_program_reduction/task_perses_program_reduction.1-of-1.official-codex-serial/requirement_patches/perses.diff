new file mode 100644
index 0000000..eba69a9
--- /dev/null
+++ b/reduction/perses_reducer.py
@@ -0,0 +1,299 @@
+"""Perses syntax-guided program reducer."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import heapq
+from itertools import count
+
+from reduction.grammar import Grammar
+from reduction.parser import Parser
+from reduction.property_test import PropertyTester
+from reduction.reducer import AbstractReducer
+from reduction.tree import NodeType, SparTreeNode
+
+
+QUANTIFIED_NODE_TYPES = {
+    NodeType.KLEENE_STAR,
+    NodeType.KLEENE_PLUS,
+    NodeType.OPTIONAL,
+}
+
+
+@dataclass(frozen=True)
+class NodeEntry:
+    """Tree node plus its stable path information."""
+
+    path: tuple[int, ...]
+    parent_path: tuple[int, ...] | None
+    child_index: int | None
+    node: SparTreeNode
+
+
+class PersesReducer(AbstractReducer):
+    """Syntax-guided reducer inspired by Perses.
+
+    The reducer repeatedly scans the tree in descending subtree-size order. It
+    applies two reduction strategies:
+
+    1. ddmin-style deletion on quantified children (root blocks, statement
+       blocks, repeated clause lists),
+    2. replacement of a node by a smaller compatible descendant using the same
+       grammar rule name.
+    """
+
+    def __init__(self, grammar: Grammar):
+        self.grammar = grammar
+        self.parser = Parser(grammar)
+
+    @property
+    def name(self) -> str:
+        return "perses"
+
+    def reduce(self, tree: SparTreeNode, tester: PropertyTester) -> SparTreeNode:
+        current = tree
+
+        while True:
+            updated = self._reduce_once(current, tester)
+            if updated is current:
+                return current
+            current = updated
+
+    def _reduce_once(
+        self,
+        tree: SparTreeNode,
+        tester: PropertyTester,
+    ) -> SparTreeNode:
+        heap: list[tuple[int, int, int, NodeEntry]] = []
+        serial = count()
+
+        for entry in self._walk_entries(tree):
+            size = entry.node.token_count()
+            if size <= 0:
+                continue
+            heapq.heappush(
+                heap,
+                (-size, len(entry.path), next(serial), entry),
+            )
+
+        while heap:
+            _, _, _, entry = heapq.heappop(heap)
+            node = self._node_at_path(tree, entry.path)
+            if node is None or node.token_count() == 0:
+                continue
+
+            if entry.path and node.node_type in (NodeType.OPTIONAL, NodeType.KLEENE_STAR):
+                candidate = self._try_delete_quantified_node(tree, entry, tester)
+                if candidate is not None:
+                    return candidate
+
+            if node.node_type in QUANTIFIED_NODE_TYPES:
+                candidate = self._ddmin_quantified_children(tree, entry.path, tester)
+                if candidate is not None:
+                    return candidate
+
+            if node.node_type == NodeType.REGULAR:
+                candidate = self._replace_with_descendant(tree, entry.path, tester)
+                if candidate is not None:
+                    return candidate
+
+        return tree
+
+    def _try_delete_quantified_node(
+        self,
+        tree: SparTreeNode,
+        entry: NodeEntry,
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        if entry.parent_path is None or entry.child_index is None:
+            return None
+
+        candidate = tree.clone()
+        parent = self._node_at_path(candidate, entry.parent_path)
+        if parent is None:
+            return None
+
+        parent.children = [
+            child
+            for index, child in enumerate(parent.children)
+            if index != entry.child_index
+        ]
+
+        source = candidate.to_source()
+        if tester.test(source):
+            return self.parser.parse(source)
+        return None
+
+    def _ddmin_quantified_children(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        working = tree.clone()
+        node = self._node_at_path(working, path)
+        if node is None or not node.children:
+            return None
+
+        minimum = 1 if node.node_type == NodeType.KLEENE_PLUS else 0
+        progress = False
+        granularity = 2
+
+        while len(node.children) > minimum:
+            partitions = self._split_indices(len(node.children), granularity)
+            changed = False
+
+            for chunk in partitions:
+                if not chunk:
+                    continue
+                if len(node.children) - len(chunk) < minimum:
+                    continue
+                candidate = working.clone()
+                candidate_node = self._node_at_path(candidate, path)
+                if candidate_node is None:
+                    break
+                candidate_node.children = [
+                    child
+                    for index, child in enumerate(candidate_node.children)
+                    if index not in chunk
+                ]
+                source = candidate.to_source()
+                if tester.test(source):
+                    working = candidate
+                    node = self._node_at_path(working, path)
+                    granularity = max(granularity - 1, 2)
+                    progress = True
+                    changed = True
+                    break
+
+            if changed:
+                continue
+
+            for chunk in partitions:
+                if len(chunk) < minimum:
+                    continue
+                candidate = working.clone()
+                candidate_node = self._node_at_path(candidate, path)
+                if candidate_node is None:
+                    break
+                candidate_node.children = [
+                    child
+                    for index, child in enumerate(candidate_node.children)
+                    if index in chunk
+                ]
+                source = candidate.to_source()
+                if tester.test(source):
+                    working = candidate
+                    node = self._node_at_path(working, path)
+                    granularity = 2
+                    progress = True
+                    changed = True
+                    break
+
+            if changed:
+                continue
+
+            if granularity >= len(node.children):
+                break
+            granularity = min(granularity * 2, len(node.children))
+
+        if progress:
+            return self.parser.parse(working.to_source())
+        return None
+
+    def _replace_with_descendant(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+        tester: PropertyTester,
+    ) -> SparTreeNode | None:
+        node = self._node_at_path(tree, path)
+        if node is None:
+            return None
+
+        candidates: list[tuple[int, int, tuple[int, ...]]] = []
+        for entry in self._walk_entries(node, path):
+            if entry.path == path:
+                continue
+            if entry.node.rule_name != node.rule_name:
+                continue
+            candidate_size = entry.node.token_count()
+            if candidate_size <= 0 or candidate_size >= node.token_count():
+                continue
+            candidates.append((candidate_size, len(entry.path), entry.path))
+
+        for _, _, candidate_path in sorted(candidates):
+            replacement = self._node_at_path(tree, candidate_path)
+            if replacement is None:
+                continue
+
+            candidate_tree = tree.clone()
+            replacement_copy = replacement.clone()
+
+            if not path:
+                source = replacement_copy.to_source()
+            else:
+                parent = self._node_at_path(candidate_tree, path[:-1])
+                if parent is None:
+                    continue
+                parent.children[path[-1]] = replacement_copy
+                source = candidate_tree.to_source()
+
+            if tester.test(source):
+                return self.parser.parse(source)
+
+        return None
+
+    def _walk_entries(
+        self,
+        node: SparTreeNode,
+        path: tuple[int, ...] = (),
+        parent_path: tuple[int, ...] | None = None,
+    ) -> list[NodeEntry]:
+        entries = [
+            NodeEntry(
+                path=path,
+                parent_path=parent_path,
+                child_index=path[-1] if path else None,
+                node=node,
+            )
+        ]
+
+        for index, child in enumerate(node.children):
+            if child.deleted:
+                continue
+            entries.extend(
+                self._walk_entries(
+                    child,
+                    path=path + (index,),
+                    parent_path=path,
+                )
+            )
+
+        return entries
+
+    def _node_at_path(
+        self,
+        tree: SparTreeNode,
+        path: tuple[int, ...],
+    ) -> SparTreeNode | None:
+        current = tree
+        for index in path:
+            if index < 0 or index >= len(current.children):
+                return None
+            current = current.children[index]
+        return current
+
+    def _split_indices(self, size: int, partitions: int) -> list[set[int]]:
+        if size <= 0:
+            return []
+        partitions = max(1, min(partitions, size))
+        base_size, remainder = divmod(size, partitions)
+        chunks: list[set[int]] = []
+        start = 0
+        for index in range(partitions):
+            extra = 1 if index < remainder else 0
+            end = start + base_size + extra
+            chunks.append(set(range(start, end)))
+            start = end
+        return chunks
diff --git a/reduction/pnf.py b/reduction/pnf.py
