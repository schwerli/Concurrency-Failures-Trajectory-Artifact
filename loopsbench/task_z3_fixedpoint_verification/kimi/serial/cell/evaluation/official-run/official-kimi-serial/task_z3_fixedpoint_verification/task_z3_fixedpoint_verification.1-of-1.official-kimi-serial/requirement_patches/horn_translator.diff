@@ -0,0 +1,51 @@
+"""Agent tests for the Horn translator layer."""
+
+from verification.horn_translator import (parse_program, HornEncoder,
+                                          verify_program, Sequence, Assign,
+                                          If, While, Assert)
+from verification.experiments.horn_exp import PROGRAMS
+
+
+def test_parser_all_programs():
+    for name, text in PROGRAMS.items():
+        ast = parse_program(text)
+        assert isinstance(ast, Sequence), name
+
+
+def test_parser_features():
+    ast = parse_program("// comment\nvar x = 1 + 2 * 3; x = x - 1;")
+    assert isinstance(ast.stmts[0], Assign)
+    assert isinstance(ast.stmts[1], Assign)
+    ast = parse_program("var x = 0; while (x < 3) bound 10 { x = x + 1; }")
+    assert isinstance(ast.stmts[1], While)
+    assert ast.stmts[1].bound == 10
+    ast = parse_program(
+        "var x = 0; if (x >= 1 and x != 2 or not (x == 3)) { x = 1; }"
+        " else { x = 2; } assert(x > 0);")
+    assert isinstance(ast.stmts[1], If)
+    assert isinstance(ast.stmts[2], Assert)
+
+
+def test_verify_safe_unsafe():
+    assert verify_program(PROGRAMS["counter"])["safe"] is True
+    assert verify_program(PROGRAMS["branch"])["safe"] is True
+    assert verify_program(PROGRAMS["nested_arith"])["safe"] is True
+    assert verify_program(PROGRAMS["unsafe_loop"])["safe"] is False
+
+
+def test_clause_counts():
+    total = 0
+    for text in PROGRAMS.values():
+        enc = HornEncoder()
+        enc.encode_program(parse_program(text))
+        total += len(enc.clauses)
+        assert enc.to_z3(enc.program_vars) is not None
+    assert total == 25
+
+
+if __name__ == "__main__":
+    test_parser_all_programs()
+    test_parser_features()
+    test_verify_safe_unsafe()
+    test_clause_counts()
+    print("horn_translator tests OK")
