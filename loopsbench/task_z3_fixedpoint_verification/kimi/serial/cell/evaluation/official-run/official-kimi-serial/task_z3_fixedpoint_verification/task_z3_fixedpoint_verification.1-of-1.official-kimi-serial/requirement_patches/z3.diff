+"""Agent tests for the smt_solver layer."""
+
+from smt_solver import count_nqueens_solutions, chromatic_number, schedule_jobs
+from framework import PETERSEN_GRAPH, DIAMOND_DAG
+
+
+def test_nqueens():
+    assert count_nqueens_solutions(4) == 2
+    assert count_nqueens_solutions(8) == 92
+
+
+def test_chromatic():
+    assert chromatic_number(PETERSEN_GRAPH) == 3
+    # DAG with no undirected edges constraint: edges only constrain endpoints
+    assert chromatic_number(DIAMOND_DAG) >= 2
+
+
+def test_schedule():
+    jobs = [("A", 3), ("B", 5), ("C", 2), ("D", 4), ("E", 6), ("F", 1)]
+    assert schedule_jobs(jobs, 3) == 7
+    # single machine: makespan is the sum of durations
+    assert schedule_jobs(jobs, 1) == 21
+
+
+if __name__ == "__main__":
+    test_nqueens()
+    test_chromatic()
+    test_schedule()
+    print("smt_solver tests OK")
