index 0000000..b4c3d31
--- /dev/null
+++ b/netsim/p4_switch.py
@@ -0,0 +1,628 @@
+"""A P4-programmable data plane.
+
+P4 describes how a switch parses packets and what it does with them: a parser
+extracts headers, a sequence of match-action tables decides on actions, and a
+deparser serialises the (possibly modified) headers back onto the wire.  This
+module models that pipeline on top of :class:`~netsim.node.Switch` so P4
+switches can be dropped into any netsim topology.
+"""
+
+from collections import OrderedDict
+
+from .node import Switch
+from .topo import Topo
+
+#: Value that matches any field value in a table entry.
+WILDCARD = "*"
+
+
+def ipv4_to_int(address):
+    """Pack a dotted-quad IPv4 address into a 32-bit integer."""
+    if isinstance(address, int):
+        return address
+    value = 0
+    for part in str(address).split("."):
+        value = (value << 8) | (int(part) & 0xFF)
+    return value
+
+
+def int_to_ipv4(value):
+    """Unpack a 32-bit integer into a dotted-quad IPv4 address."""
+    value = int(value)
+    return ".".join(str((value >> shift) & 0xFF) for shift in (24, 16, 8, 0))
+
+
+def mac_to_int(address):
+    """Pack a colon-separated MAC address into a 48-bit integer."""
+    if isinstance(address, int):
+        return address
+    value = 0
+    for part in str(address).split(":"):
+        value = (value << 8) | (int(part, 16) & 0xFF)
+    return value
+
+
+class P4TableEntry:
+    """One rule of a match-action table."""
+
+    def __init__(self, match, action_name, action_params=None, priority=0,
+                 index=0):
+        self.match = dict(match or {})
+        self.action_name = action_name
+        self.action_params = dict(action_params or {})
+        self.priority = int(priority)
+        self.index = int(index)
+        self.hit_count = 0
+        self.byte_count = 0
+
+    def matches(self, packet_headers):
+        """True when every field of this entry agrees with the headers."""
+        for field, expected in self.match.items():
+            if expected is None or expected == WILDCARD:
+                continue
+            if field not in packet_headers:
+                return False
+            if packet_headers[field] != expected:
+                return False
+        return True
+
+    def hit(self, packet_bytes=0):
+        self.hit_count += 1
+        self.byte_count += int(packet_bytes)
+        return self
+
+    def __repr__(self):
+        return "<P4TableEntry %s -> %s%s prio=%d>" % (
+            self.match, self.action_name,
+            self.action_params or "", self.priority)
+
+
+class P4MatchActionTable:
+    """A named match-action table with a bounded number of entries."""
+
+    def __init__(self, name, match_fields, max_size=1024,
+                 default_action=None, default_action_params=None):
+        self.name = name
+        self.match_fields = list(match_fields or [])
+        self.max_size = int(max_size)
+        self.default_action = default_action
+        self.default_action_params = dict(default_action_params or {})
+        self.entries = []
+        self.counter = None
+        self.hit_count = 0
+        self.miss_count = 0
+
+    # -- rule management ----------------------------------------------------
+    def add_rule(self, match_dict, action_name, action_params=None,
+                 priority=0):
+        """Install a rule; returns the entry, or ``None`` if the table is full.
+
+        An entry is identified by its match key *and* priority, so re-adding
+        the same key overwrites the old action (as a target would) while the
+        same key at another priority becomes a separate, lower-preference entry.
+        """
+        existing = self.find_rule(match_dict, priority=priority)
+        if existing is None and len(self.entries) >= self.max_size:
+            return None
+        entry = P4TableEntry(match_dict, action_name,
+                             action_params=action_params, priority=priority,
+                             index=len(self.entries))
+        if existing is not None:
+            entry.index = existing.index
+            self.entries[self.entries.index(existing)] = entry
+            return entry
+        self.entries.append(entry)
+        return entry
+
+    def find_rule(self, match_dict, priority=None):
+        """Return the entry with this match key (and priority, if given)."""
+        wanted = dict(match_dict or {})
+        for entry in self.entries:
+            if entry.match != wanted:
+                continue
+            if priority is None or entry.priority == priority:
+                return entry
+        return None
+
+    def delete_rule(self, match_dict, priority=None):
+        """Remove a rule by its match key; returns True when one was removed."""
+        entry = self.find_rule(match_dict, priority=priority)
+        if entry is None:
+            return False
+        self.entries.remove(entry)
+        return True
+
+    def clear(self):
+        self.entries = []
+        return self
+
+    def size(self):
+        return len(self.entries)
+
+    def is_full(self):
+        return len(self.entries) >= self.max_size
+
+    def attach_counter(self, counter):
+        """Attach a direct counter, indexed by entry position."""
+        self.counter = counter
+        return counter
+
+    def set_default_action(self, action_name, action_params=None):
+        self.default_action = action_name
+        self.default_action_params = dict(action_params or {})
+        return self
+
+    # -- lookup -------------------------------------------------------------
+    def lookup(self, packet_headers, packet_bytes=0):
+        """Return the highest-priority matching entry, or ``None`` on a miss.
+
+        Ties are broken by installation order, as on a real target.  The entry's
+        statistics (and the direct counter, if any) are updated on a hit.
+        """
+        best = None
+        for entry in self.entries:
+            if not entry.matches(packet_headers):
+                continue
+            if best is None or entry.priority > best.priority:
+                best = entry
+        if best is None:
+            self.miss_count += 1
+            return None
+        self.hit_count += 1
+        best.hit(packet_bytes)
+        if self.counter is not None:
+            self.counter.increment(best.index, packet_bytes)
+        return best
+
+    def __len__(self):
+        return len(self.entries)
+
+    def __repr__(self):
+        return "<P4MatchActionTable %s entries=%d/%d>" % (
+            self.name, len(self.entries), self.max_size)
+
+
+class P4Parser:
+    """Extracts header fields from raw packet bytes.
+
+    ``header_defs`` maps a field name to ``(offset, length)`` in bytes; every
+    field is decoded as a big-endian unsigned integer.
+    """
+
+    def __init__(self, header_defs):
+        self.header_defs = OrderedDict(header_defs or {})
+
+    @property
+    def min_length(self):
+        """Bytes a packet must carry for every header field to be present."""
+        if not self.header_defs:
+            return 0
+        return max(offset + length
+                   for offset, length in self.header_defs.values())
+
+    @property
+    def header_length(self):
+        return self.min_length
+
+    @staticmethod
+    def _as_bytes(packet_data):
+        if isinstance(packet_data, (bytes, bytearray, memoryview)):
+            return bytes(packet_data)
+        if packet_data is None:
+            return b""
+        return str(packet_data).encode("latin-1")
+
+    def is_valid(self, packet_data):
+        """True when the packet is long enough to be parsed."""
+        return len(self._as_bytes(packet_data)) >= self.min_length
+
+    def parse(self, packet_data):
+        """Return ``{field: value}`` for every header field."""
+        data = self._as_bytes(packet_data)
+        headers = OrderedDict()
+        for field, (offset, length) in self.header_defs.items():
+            chunk = data[offset:offset + length]
+            if len(chunk) < length:
+                continue
+            headers[field] = int.from_bytes(chunk, "big")
+        return headers
+
+    def payload(self, packet_data):
+        """Everything after the parsed headers."""
+        return self._as_bytes(packet_data)[self.min_length:]
+
+
+class P4Deparser:
+    """Reassembles packet bytes from (possibly modified) header fields."""
+
+    def __init__(self, header_defs):
+        self.header_defs = OrderedDict(header_defs or {})
+
+    @property
+    def header_length(self):
+        if not self.header_defs:
+            return 0
+        return max(offset + length
+                   for offset, length in self.header_defs.values())
+
+    def deparse(self, headers, payload=b""):
+        """Serialise ``headers`` followed by ``payload``."""
+        buffer = bytearray(self.header_length)
+        for field, (offset, length) in self.header_defs.items():
+            if field not in headers:
+                continue
+            value = headers[field]
+            if isinstance(value, (bytes, bytearray)):
+                chunk = bytes(value)[:length].rjust(length, b"\x00")
+            else:
+                chunk = int(value).to_bytes(length, "big")
+            buffer[offset:offset + length] = chunk
+        if payload is None:
+            payload = b""
+        if not isinstance(payload, (bytes, bytearray, memoryview)):
+            payload = str(payload).encode("latin-1")
+        return bytes(buffer) + bytes(payload)
+
+
+class P4Counter:
+    """An array of (packet, byte) counters, as declared by a P4 program."""
+
+    def __init__(self, name, size):
+        self.name = name
+        self.size = int(size)
+        self.packets = [0] * self.size
+        self.bytes = [0] * self.size
+
+    def _valid(self, index):
+        return 0 <= int(index) < self.size
+
+    def increment(self, index, packet_bytes=0):
+        """Count one packet of ``packet_bytes`` bytes in cell ``index``."""
+        if not self._valid(index):
+            return False
+        index = int(index)
+        self.packets[index] += 1
+        self.bytes[index] += int(packet_bytes)
+        return True
+
+    def read(self, index):
+        """Return ``(packets, bytes)`` for one cell."""
+        if not self._valid(index):
+            return (0, 0)
+        index = int(index)
+        return (self.packets[index], self.bytes[index])
+
+    def reset(self, index=None):
+        """Clear one cell, or the whole array when ``index`` is None."""
+        if index is None:
+            self.packets = [0] * self.size
+            self.bytes = [0] * self.size
+            return True
+        if not self._valid(index):
+            return False
+        self.packets[int(index)] = 0
+        self.bytes[int(index)] = 0
+        return True
+
+    def total_packets(self):
+        return sum(self.packets)
+
+    def total_bytes(self):
+        return sum(self.bytes)
+
+    def __len__(self):
+        return self.size
+
+    def __repr__(self):
+        return "<P4Counter %s size=%d packets=%d bytes=%d>" % (
+            self.name, self.size, self.total_packets(), self.total_bytes())
+
+
+class P4MulticastGroup:
+    """A packet replication engine group: one packet in, one copy per port."""
+
+    def __init__(self, group_id, ports=None):
+        self.group_id = group_id
+        self.ports = list(ports or [])
+
+    def add_port(self, port):
+        if port not in self.ports:
+            self.ports.append(port)
+        return self.ports
+
+    def remove_port(self, port):
+        if port in self.ports:
+            self.ports.remove(port)
+        return self.ports
+
+    def replicate(self, packet_data):
+        """Return one ``(port, packet_data)`` copy per member port."""
+        return [(port, packet_data) for port in self.ports]
+
+    def num_copies(self):
+        return len(self.ports)
+
+    def __len__(self):
+        return len(self.ports)
+
+    def __repr__(self):
+        return "<P4MulticastGroup %s ports=%s>" % (self.group_id, self.ports)
+
+
+class P4Switch(Switch):
+    """A switch whose behaviour is defined by a P4 program.
+
+    Tables are evaluated in registration order; each hit applies its action,
+    which can set the egress port, rewrite a header field, drop the packet or
+    hand it to a multicast group.
+    """
+
+    #: Simulated cost (microseconds) of one match-action stage.
+    TABLE_LATENCY_US = 0.5
+
+    #: Actions that stop the pipeline.
+    DROP_ACTIONS = ("drop", "_drop", "NoAction_drop")
+
+    def __init__(self, name, program=None, **params):
+        Switch.__init__(self, name, **params)
+        self.program = program
+        self.tables = OrderedDict()
+        self.counters = OrderedDict()
+        self.multicast_groups = OrderedDict()
+        self.parser = None
+        self.deparser = None
+        self.packets_processed = 0
+        self.packets_dropped = 0
+        self.parse_errors = 0
+
+    # -- programming --------------------------------------------------------
+    def add_table(self, table):
+        self.tables[table.name] = table
+        return table
+
+    def get_table(self, name):
+        return self.tables.get(name)
+
+    def add_counter(self, counter):
+        self.counters[counter.name] = counter
+        return counter
+
+    def get_counter(self, name):
+        return self.counters.get(name)
+
+    def set_parser(self, parser):
+        self.parser = parser
+        return parser
+
+    def set_deparser(self, deparser):
+        self.deparser = deparser
+        return deparser
+
+    def add_multicast_group(self, group):
+        self.multicast_groups[group.group_id] = group
+        return group
+
+    def get_multicast_group(self, group_id):
+        return self.multicast_groups.get(group_id)
+
+    def total_table_entries(self):
+        """Entries installed across every table of this switch."""
+        return sum(table.size() for table in self.tables.values())
+
+    @property
+    def num_tables(self):
+        return len(self.tables)
+
+    @property
+    def pipeline_latency_us(self):
+        """Pipeline cost: ``TABLE_LATENCY_US`` per match-action stage."""
+        return self.TABLE_LATENCY_US * len(self.tables)
+
+    # -- pipeline -----------------------------------------------------------
+    def process_packet(self, packet_data):
+        """Run parse -> match-action tables -> deparse for one packet.
+
+        Returns a result dict with the parsed/modified ``headers``, the chosen
+        ``egress_port``, any multicast ``copies``, the tables that were hit and
+        the re-serialised ``packet``.
+        """
+        result = {
+            "headers": {},
+            "egress_port": None,
+            "copies": [],
+            "hits": [],
+            "actions": [],
+            "dropped": False,
+            "valid": True,
+            "packet": None,
+            "latency_us": self.pipeline_latency_us,
+        }
+        data = P4Parser._as_bytes(packet_data)
+        packet_bytes = len(data)
+        result["bytes"] = packet_bytes
+
+        if self.parser is None or not self.parser.is_valid(data):
+            self.parse_errors += 1
+            self.packets_dropped += 1
+            result["valid"] = False
+            result["dropped"] = True
+            return result
+
+        headers = self.parser.parse(data)
+        payload = self.parser.payload(data)
+        self.packets_processed += 1
+
+        for table in self.tables.values():
+            entry = table.lookup(headers, packet_bytes)
+            action_name = entry.action_name if entry is not None \
+                else table.default_action
+            action_params = entry.action_params if entry is not None \
+                else table.default_action_params
+            if entry is not None:
+                result["hits"].append(table.name)
+            if action_name is None:
+                continue
+            result["actions"].append(action_name)
+            if self._apply_action(action_name, action_params, headers, result,
+                                 packet_bytes):
+                break
+
+        if result["dropped"]:
+            return result
+
+        if self.deparser is not None:
+            result["packet"] = self.deparser.deparse(headers, payload)
+        else:
+            result["packet"] = data
+        result["headers"] = headers
+        group = self.multicast_groups.get(result.get("multicast_group"))
+        if group is not None:
+            result["copies"] = group.replicate(result["packet"])
+        return result
+
+    def _apply_action(self, action_name, action_params, headers, result,
+                      packet_bytes):
+        """Apply one action; returns True when the pipeline should stop."""
+        params = dict(action_params or {})
+        counter = self.counters.get(params.get("counter"))
+        if counter is not None:
+            counter.increment(params.get("counter_index", 0), packet_bytes)
+
+        if action_name in self.DROP_ACTIONS:
+            self.packets_dropped += 1
+            result["dropped"] = True
+            result["egress_port"] = None
+            result["copies"] = []
+            return True
+        if action_name in ("multicast", "set_mcast_grp"):
+            group = self.multicast_groups.get(params.get("group"))
+            if group is not None:
+                result["multicast_group"] = group.group_id
+            return False
+        if action_name in ("set_field", "modify_field", "rewrite"):
+            field = params.get("field")
+            if field is not None:
+                headers[field] = params.get("value")
+            return False
+        if action_name in ("decrement_ttl", "dec_ttl"):
+            field = params.get("field", "ipv4_ttl")
+            if field in headers:
+                headers[field] = max(0, headers[field] - 1)
+            return False
+        # forward / ipv4_forward / send_to_port and friends
+        if "port" in params:
+            result["egress_port"] = params["port"]
+        if "dst_mac" in params:
+            headers["eth_dst"] = mac_to_int(params["dst_mac"])
+        return False
+
+    def __repr__(self):
+        return "<P4Switch %s program=%s tables=%d entries=%d>" % (
+            self.name, self.program, len(self.tables),
+            self.total_table_entries())
+
+
+class P4Topology(Topo):
+    """A chain of P4 switches, each with its own hosts attached.
+
+    ``s1..sN`` form a line; every switch gets ``num_hosts_per_switch`` hosts.
+    ``link_params`` (``bw``, ``delay``, ``loss``) apply to every link.
+    """
+
+    def __init__(self, num_switches=2, num_hosts_per_switch=1, **link_params):
+        self.p4_switch_names = []
+        Topo.__init__(self, lopts=link_params, num_switches=num_switches,
+                      num_hosts_per_switch=num_hosts_per_switch)
+
+    def build(self, num_switches=2, num_hosts_per_switch=1, **params):
+        self.num_switches = int(num_switches)
+        self.num_hosts_per_switch = int(num_hosts_per_switch)
+        previous = None
+        host_index = 1
+        for index in range(1, self.num_switches + 1):
+            switch = self.addP4Switch("s%d" % index,
+                                      program="simple_router.p4")
+            for _ in range(self.num_hosts_per_switch):
+                host = self.addHost("h%d" % host_index)
+                host_index += 1
+                self.addLink(host, switch, **self.lopts)
+            if previous is not None:
+                self.addLink(previous, switch, **self.lopts)
+            previous = switch
+        return previous
+
+    def addP4Switch(self, name, **params):
+        """Add a switch that will be instantiated as a :class:`P4Switch`."""
+        params.setdefault("cls", P4Switch)
+        if name not in self.p4_switch_names:
+            self.p4_switch_names.append(name)
+        return self.addSwitch(name, **params)
+
+    def p4_switches(self):
+        return list(self.p4_switch_names)
+
+    def isP4Switch(self, name):
+        return name in self.p4_switch_names
+
+
+#: Ethernet + IPv4 header layout used by the P4 experiments (byte offsets).
+ETH_IPV4_HEADERS = OrderedDict([
+    ("eth_dst", (0, 6)),
+    ("eth_src", (6, 6)),
+    ("eth_type", (12, 2)),
+    ("ipv4_ttl", (22, 1)),
+    ("ipv4_proto", (23, 1)),
+    ("ipv4_src", (26, 4)),
+    ("ipv4_dst", (30, 4)),
+])
+
+
+def build_eth_ipv4_packet(src_ip="10.0.0.1", dst_ip="10.0.0.2", ttl=64,
+                          proto=6, size_bytes=1500, deparser=None):
+    """Serialise a minimal Ethernet/IPv4 packet padded to ``size_bytes``."""
+    deparser = deparser or P4Deparser(ETH_IPV4_HEADERS)
+    headers = {
+        "eth_dst": mac_to_int("00:00:00:00:00:02"),
+        "eth_src": mac_to_int("00:00:00:00:00:01"),
+        "eth_type": 0x0800,
+        "ipv4_ttl": ttl,
+        "ipv4_proto": proto,
+        "ipv4_src": ipv4_to_int(src_ip),
+        "ipv4_dst": ipv4_to_int(dst_ip),
+    }
+    padding = max(0, int(size_bytes) - deparser.header_length)
+    return deparser.deparse(headers, b"\x00" * padding)
+
+
+def make_ipv4_pipeline(switch, table_names=("ipv4_lpm",), counter_size=None,
+                       counter_name="ipv4_counter"):
+    """Attach a parser, deparser, tables and a direct counter to ``switch``."""
+    switch.set_parser(P4Parser(ETH_IPV4_HEADERS))
+    switch.set_deparser(P4Deparser(ETH_IPV4_HEADERS))
+    tables = []
+    for name in table_names:
+        tables.append(switch.add_table(
+            P4MatchActionTable(name, ["ipv4_dst"])))
+    if counter_size:
+        counter = switch.add_counter(P4Counter(counter_name, counter_size))
+        tables[0].attach_counter(counter)
+    return tables
+
+
+__all__ = [
+    "ETH_IPV4_HEADERS",
+    "P4Counter",
+    "P4Deparser",
+    "P4MatchActionTable",
+    "P4MulticastGroup",
+    "P4Parser",
+    "P4Switch",
+    "P4TableEntry",
+    "P4Topology",
+    "WILDCARD",
+    "build_eth_ipv4_packet",
+    "int_to_ipv4",
+    "ipv4_to_int",
+    "mac_to_int",
+    "make_ipv4_pipeline",
+]
