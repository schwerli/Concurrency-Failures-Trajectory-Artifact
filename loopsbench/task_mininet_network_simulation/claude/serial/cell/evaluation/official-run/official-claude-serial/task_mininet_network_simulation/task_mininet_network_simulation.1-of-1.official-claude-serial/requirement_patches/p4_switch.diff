--- /dev/null
+++ b/agent_tests/test_p4.py
@@ -0,0 +1,202 @@
+"""Tests for the P4 programmable data plane (netsim.p4_switch)."""
+
+import sys
+
+sys.path.insert(0, "/workspace")
+
+from netsim.net import Mininet  # noqa: E402
+from netsim.node import Switch  # noqa: E402
+from netsim.p4_switch import (ETH_IPV4_HEADERS, P4Counter,  # noqa: E402
+                              P4Deparser, P4MatchActionTable,
+                              P4MulticastGroup, P4Parser, P4Switch,
+                              P4Topology, WILDCARD, build_eth_ipv4_packet,
+                              int_to_ipv4, ipv4_to_int, make_ipv4_pipeline)
+from netsim.topo import Topo  # noqa: E402
+
+
+def test_match_action_table_rule_management():
+    table = P4MatchActionTable("ipv4_lpm", ["ipv4_dst"], max_size=2)
+    assert table.size() == 0
+    assert table.add_rule({"ipv4_dst": 1}, "forward", {"port": 1}) is not None
+    assert table.add_rule({"ipv4_dst": 2}, "forward", {"port": 2}) is not None
+    assert table.size() == 2
+    # capacity is enforced
+    assert table.add_rule({"ipv4_dst": 3}, "forward", {"port": 3}) is None
+    assert table.size() == 2
+    assert table.delete_rule({"ipv4_dst": 1}) is True
+    assert table.delete_rule({"ipv4_dst": 1}) is False
+    assert table.size() == 1
+    # re-adding a key overwrites the action instead of growing the table
+    table.add_rule({"ipv4_dst": 2}, "forward", {"port": 8})
+    assert table.size() == 1
+    assert table.lookup({"ipv4_dst": 2}).action_params["port"] == 8
+    table.clear()
+    assert table.size() == 0 and len(table) == 0
+
+
+def test_table_lookup_priority_and_wildcards():
+    table = P4MatchActionTable("acl", ["ipv4_dst", "ipv4_proto"])
+    table.add_rule({"ipv4_dst": WILDCARD}, "drop", priority=0)
+    table.add_rule({"ipv4_dst": 10}, "forward", {"port": 7}, priority=20)
+    table.add_rule({"ipv4_dst": 10}, "forward", {"port": 9}, priority=5)
+    hit = table.lookup({"ipv4_dst": 10, "ipv4_proto": 6}, 100)
+    assert hit.action_name == "forward" and hit.action_params["port"] == 7
+    assert hit.hit_count == 1 and hit.byte_count == 100
+    # the wildcard rule catches everything else
+    other = table.lookup({"ipv4_dst": 99, "ipv4_proto": 6})
+    assert other.action_name == "drop"
+    # a field the packet does not carry cannot match
+    empty = P4MatchActionTable("t", ["x"])
+    empty.add_rule({"x": 1}, "forward")
+    assert empty.lookup({"y": 1}) is None
+    assert empty.miss_count == 1
+
+
+def test_parser_and_deparser_round_trip():
+    parser = P4Parser(ETH_IPV4_HEADERS)
+    deparser = P4Deparser(ETH_IPV4_HEADERS)
+    assert parser.min_length == 34
+    assert parser.is_valid(b"\x00" * 34) is True
+    assert parser.is_valid(b"\x00" * 33) is False
+    packet = build_eth_ipv4_packet(src_ip="10.0.0.1", dst_ip="10.0.0.9",
+                                   ttl=64, size_bytes=100)
+    assert len(packet) == 100
+    headers = parser.parse(packet)
+    assert headers["ipv4_src"] == ipv4_to_int("10.0.0.1")
+    assert int_to_ipv4(headers["ipv4_dst"]) == "10.0.0.9"
+    assert headers["eth_type"] == 0x0800 and headers["ipv4_ttl"] == 64
+    # modifying a field and deparsing reproduces the packet with that change
+    headers["ipv4_ttl"] = 63
+    rebuilt = deparser.deparse(headers, parser.payload(packet))
+    assert len(rebuilt) == len(packet)
+    assert parser.parse(rebuilt)["ipv4_ttl"] == 63
+    assert parser.parse(rebuilt)["ipv4_dst"] == headers["ipv4_dst"]
+
+
+def test_counter_array():
+    counter = P4Counter("ipv4_counter", 4)
+    assert len(counter) == 4
+    counter.increment(0, 100)
+    counter.increment(0, 200)
+    counter.increment(3, 50)
+    assert counter.read(0) == (2, 300)
+    assert counter.read(3) == (1, 50)
+    assert counter.read(1) == (0, 0)
+    assert counter.total_packets() == 3 and counter.total_bytes() == 350
+    # out of range indices are ignored, not fatal
+    assert counter.increment(9, 1) is False
+    assert counter.read(9) == (0, 0)
+    assert counter.reset(0) is True
+    assert counter.read(0) == (0, 0) and counter.total_packets() == 1
+    counter.reset()
+    assert counter.total_packets() == 0 and counter.total_bytes() == 0
+
+
+def test_multicast_group_replication():
+    group = P4MulticastGroup(1, [1, 2, 3])
+    copies = group.replicate(b"abc")
+    assert copies == [(1, b"abc"), (2, b"abc"), (3, b"abc")]
+    group.add_port(4)
+    group.add_port(4)  # idempotent
+    assert group.num_copies() == 4
+    group.remove_port(1)
+    assert group.ports == [2, 3, 4] and len(group.replicate(b"x")) == 3
+
+
+def test_p4_switch_pipeline():
+    assert issubclass(P4Switch, Switch)
+    switch = P4Switch("s1", program="simple_router.p4")
+    assert switch.program == "simple_router.p4"
+    assert switch.pipeline_latency_us == 0.0
+    tables = make_ipv4_pipeline(switch, table_names=("ipv4_lpm", "acl"),
+                                counter_size=4)
+    assert switch.get_table("ipv4_lpm") is tables[0]
+    assert switch.get_counter("ipv4_counter") is not None
+    assert switch.get_table("nope") is None and switch.get_counter("x") is None
+    # 0.5us per stage
+    assert switch.pipeline_latency_us == 1.0
+
+    tables[0].add_rule({"ipv4_dst": ipv4_to_int("10.0.0.2")}, "ipv4_forward",
+                       {"port": 2})
+    result = switch.process_packet(
+        build_eth_ipv4_packet(dst_ip="10.0.0.2", size_bytes=200))
+    assert result["valid"] and not result["dropped"]
+    assert result["egress_port"] == 2
+    assert result["hits"] == ["ipv4_lpm"]
+    assert len(result["packet"]) == 200
+    assert switch.get_counter("ipv4_counter").read(0) == (1, 200)
+    assert switch.packets_processed == 1
+
+    # a drop action ends the pipeline
+    tables[1].add_rule({"ipv4_dst": ipv4_to_int("10.0.0.3")}, "drop")
+    dropped = switch.process_packet(build_eth_ipv4_packet(dst_ip="10.0.0.3"))
+    assert dropped["dropped"] is True and dropped["egress_port"] is None
+    assert switch.packets_dropped == 1
+
+    # too-short packets fail the parser
+    invalid = switch.process_packet(b"\x00" * 10)
+    assert invalid["valid"] is False and switch.parse_errors == 1
+
+
+def test_p4_switch_header_rewrite_and_multicast():
+    switch = P4Switch("s1")
+    make_ipv4_pipeline(switch, table_names=("ttl", "mcast"))
+    switch.add_multicast_group(P4MulticastGroup(7, [1, 2, 3]))
+    switch.get_table("ttl").add_rule({"ipv4_dst": WILDCARD}, "decrement_ttl")
+    switch.get_table("mcast").add_rule({"ipv4_dst": WILDCARD}, "multicast",
+                                       {"group": 7})
+    result = switch.process_packet(build_eth_ipv4_packet(ttl=10))
+    assert result["headers"]["ipv4_ttl"] == 9
+    assert len(result["copies"]) == 3
+    # every copy carries the deparsed packet, TTL decrement included
+    ports = [port for port, _ in result["copies"]]
+    assert ports == [1, 2, 3]
+    assert all(data == result["packet"] for _, data in result["copies"])
+    assert P4Parser(ETH_IPV4_HEADERS).parse(result["packet"])["ipv4_ttl"] == 9
+
+
+def test_p4_topology_builds_switch_chain():
+    assert issubclass(P4Topology, Topo)
+    topo = P4Topology(num_switches=4, num_hosts_per_switch=2, bw=1000,
+                      delay=0.5)
+    assert len(topo.switches()) == 4 and len(topo.hosts()) == 8
+    assert topo.isP4Switch("s1") and not topo.isP4Switch("h1")
+    # 8 host links + 3 inter-switch links
+    assert len(topo.links()) == 11
+    net = Mininet(topo=topo, switch=P4Switch)
+    net.start()
+    assert all(isinstance(s, P4Switch) for s in net.switches)
+    assert net.path("h1", "h8") == ["h1", "s1", "s2", "s3", "s4", "h8"]
+    assert topo.linkInfo("h1", "s1")["bw"] == 1000
+
+
+def test_p4_experiment_values():
+    from netsim.experiments import p4_exp
+
+    assert p4_exp.experiment_table_entries() == 32
+    assert abs(p4_exp.experiment_forwarding_rate() - 1000 * 0.98 ** 4) < 1e-6
+    assert p4_exp.experiment_counter_accuracy() == 1.0
+    assert p4_exp.experiment_pipeline_latency() == 1.5
+    assert p4_exp.experiment_multicast_copies() == 6
+
+
+def test_programmed_rules_forward_along_the_path():
+    from netsim.experiments.p4_exp import (build_p4_net,
+                                           program_forwarding_rules)
+
+    net = build_p4_net()
+    assert program_forwarding_rules(net) == 32
+    # s1 must send traffic for h8 towards s2, and traffic for h1 to h1's port
+    s1 = net["s1"]
+    parser = P4Parser(ETH_IPV4_HEADERS)
+    to_h8 = s1.process_packet(build_eth_ipv4_packet(dst_ip=net["h8"].ip))
+    to_h1 = s1.process_packet(build_eth_ipv4_packet(dst_ip=net["h1"].ip))
+    towards_s2 = net.linkBetween("s1", "s2")
+    towards_h1 = net.linkBetween("s1", "h1")
+    assert to_h8["egress_port"] == (
+        towards_s2.port1 if towards_s2.node1 is s1 else towards_s2.port2)
+    assert to_h1["egress_port"] == (
+        towards_h1.port1 if towards_h1.node1 is s1 else towards_h1.port2)
+    assert to_h8["egress_port"] != to_h1["egress_port"]
+    assert parser.parse(to_h8["packet"])["ipv4_dst"] == \
+        ipv4_to_int(net["h8"].ip)
