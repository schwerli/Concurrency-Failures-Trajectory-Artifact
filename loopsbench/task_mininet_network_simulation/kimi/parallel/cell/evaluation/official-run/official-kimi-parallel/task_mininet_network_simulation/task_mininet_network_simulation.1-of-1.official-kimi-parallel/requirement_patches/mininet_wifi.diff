+"""WiFi station: a mobile wireless client host."""
+
+from netsim.node import Host
+
+
+class Station(Host):
+    """WiFi client with a 2D position and an associated access point."""
+
+    def __init__(self, name, position=(0.0, 0.0), **params):
+        """Create a station at the given (x, y) position."""
+        super().__init__(name, **params)
+        self.position = position
+        self.associated_ap = None
+
+    def set_position(self, x, y):
+        """Move the station to a new (x, y) position."""
+        self.position = (x, y)
