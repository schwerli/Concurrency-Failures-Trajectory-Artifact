index 0000000..48cd3e8
--- /dev/null
+++ b/netsim/wifi/propagation.py
@@ -0,0 +1,40 @@
+"""Wireless propagation models: Friis free-space and log-distance path loss."""
+
+import math
+
+SPEED_OF_LIGHT = 3e8
+
+
+def friis_free_space_loss(freq_hz, distance_m):
+    """Free-space path loss in dB: 20*log10(4*pi*d*f/c)."""
+    if distance_m <= 0:
+        return 0.0
+    return 20.0 * math.log10(4.0 * math.pi * distance_m * freq_hz / SPEED_OF_LIGHT)
+
+
+def log_distance_path_loss(freq_hz, distance_m, path_loss_exp=3.0,
+                           ref_distance_m=1.0):
+    """Log-distance path loss in dB: PL(d) = PL(d0) + 10*n*log10(d/d0).
+
+    PL(d0) is the Friis free-space loss at the reference distance.
+    """
+    if distance_m <= 0:
+        distance_m = ref_distance_m
+    pl_ref = friis_free_space_loss(freq_hz, ref_distance_m)
+    return pl_ref + 10.0 * path_loss_exp * math.log10(distance_m / ref_distance_m)
+
+
+def received_signal_strength(tx_power_dbm, freq_hz, distance_m, tx_gain_dbi=0.0,
+                             rx_gain_dbi=0.0, path_loss_exp=3.0,
+                             ref_distance_m=1.0):
+    """RSSI in dBm: tx_power + antenna gains - log-distance path loss."""
+    pl = log_distance_path_loss(freq_hz, distance_m, path_loss_exp, ref_distance_m)
+    return tx_power_dbm + tx_gain_dbi + rx_gain_dbi - pl
+
+
+def max_range(tx_power_dbm, min_rssi_dbm, freq_hz, tx_gain_dbi=0.0,
+              rx_gain_dbi=0.0, path_loss_exp=3.0, ref_distance_m=1.0):
+    """Solve for the distance at which RSSI falls to min_rssi_dbm."""
+    pl_ref = friis_free_space_loss(freq_hz, ref_distance_m)
+    budget = tx_power_dbm + tx_gain_dbi + rx_gain_dbi - pl_ref - min_rssi_dbm
+    return ref_distance_m * 10.0 ** (budget / (10.0 * path_loss_exp))
