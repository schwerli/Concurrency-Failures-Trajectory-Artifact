+"""WiFi access point: a switch with radio parameters and associations."""
+
+from netsim.node import Switch
+
+
+class AccessPoint(Switch):
+    """Wireless access point with position, radio config, and stations."""
+
+    def __init__(self, name, position=(0.0, 0.0), ssid="netsim-wifi", channel=1,
+                 tx_power_dbm=20.0, freq_ghz=2.4, path_loss_exp=3.0,
+                 min_rssi_dbm=-80.0, **params):
+        """Create an access point with radio and propagation parameters."""
+        super().__init__(name, **params)
+        self.position = position
+        self.ssid = ssid
+        self.channel = channel
+        self.tx_power_dbm = tx_power_dbm
+        self.freq_ghz = freq_ghz
+        self.path_loss_exp = path_loss_exp
+        self.min_rssi_dbm = min_rssi_dbm
+        self.associated_stations = []
