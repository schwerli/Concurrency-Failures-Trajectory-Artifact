++
++class Link:
++    """A link connecting two nodes, creating one interface on each side."""
++
++    def __init__(self, node1, node2, port1=None, port2=None,
++                 bw=None, delay=None, loss=None, **params):
++        self.node1 = node1
++        self.node2 = node2
++        self.bw = bw
++        self.delay = delay
++        self.loss = loss
++        self.params = dict(params)
++
++        if port1 is None:
++            port1 = node1.new_port()
++        if port2 is None:
++            port2 = node2.new_port()
++
++        self.intf1 = Intf(f"{node1.name}-eth{port1}", node1, port=port1, link=self)
++        self.intf2 = Intf(f"{node2.name}-eth{port2}", node2, port=port2, link=self)
++        node1.add_intf(self.intf1)
++        node2.add_intf(self.intf2)
++
++    def other_node(self, node):
++        if node is self.node1:
++            return self.node2
++        if node is self.node2:
++            return self.node1
++        return None
++
++    def __repr__(self):
++        return f"<{self.__class__.__name__} {self.node1.name}-{self.node2.name}>"
++
++
++class TCLink(Link):
++    """Traffic-controlled link with explicit bandwidth, delay, and loss."""
