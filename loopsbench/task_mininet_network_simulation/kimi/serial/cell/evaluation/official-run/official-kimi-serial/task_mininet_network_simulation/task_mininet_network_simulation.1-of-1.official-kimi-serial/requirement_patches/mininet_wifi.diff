++"""Node classes for Mininet-style network emulation."""
++
++
++class Node:
++    """Base class for all emulated network nodes."""
++
++    def __init__(self, name, **params):
++        self.name = name
++        self.params = dict(params)
++        self.intfs = {}  # intf name -> Intf
++        self.ip = params.get("ip", None)
++
++    def new_port(self):
++        """Return the next free port number on this node."""
++        port = 0
++        used = {intf.port for intf in self.intfs.values()}
++        while port in used:
++            port += 1
++        return port
++
++    def add_intf(self, intf):
++        self.intfs[intf.name] = intf
++
++    def __repr__(self):
++        return f"<{self.__class__.__name__} {self.name}>"
++
++
++class Host(Node):
++    """Emulated network host."""
++
++    def __init__(self, name, **params):
++        super().__init__(name, **params)
++
++
++class Switch(Node):
++    """OpenFlow switch.
++
++    FORWARDING_OVERHEAD: fraction of throughput lost per switch hop
++    (2% reduction per switch traversed).
++    """
++
++    FORWARDING_OVERHEAD = 0.02
++
++    def __init__(self, name, **params):
++        super().__init__(name, **params)
++
++
++class OVSSwitch(Switch):
++    """Open vSwitch implementation."""
++
++    def __init__(self, name, **params):
++        super().__init__(name, **params)
++
++
++class Controller(Node):
++    """SDN controller."""
++
++    def __init__(self, name, **params):
++        super().__init__(name, **params)
