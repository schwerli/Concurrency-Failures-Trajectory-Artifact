+"""WiFi access point node."""
+
+from ..node import Switch
+
+
+class AccessPoint(Switch):
+    """WiFi access point with radio and association parameters."""
+
+    def __init__(self, name, position=(0.0, 0.0), ssid="netsim-ssid",
+                 channel=1, tx_power_dbm=20.0, freq_ghz=2.4,
+                 path_loss_exp=3.0, min_rssi_dbm=-80.0, **params):
+        super().__init__(name, **params)
+        self.position = tuple(position)
+        self.ssid = ssid
+        self.channel = channel
+        self.tx_power_dbm = tx_power_dbm
+        self.freq_ghz = freq_ghz
+        self.path_loss_exp = path_loss_exp
+        self.min_rssi_dbm = min_rssi_dbm
+        self.associated_stations = []
+
+    def set_position(self, x, y=None):
+        if y is None:
+            self.position = tuple(x)
+        else:
+            self.position = (x, y)
