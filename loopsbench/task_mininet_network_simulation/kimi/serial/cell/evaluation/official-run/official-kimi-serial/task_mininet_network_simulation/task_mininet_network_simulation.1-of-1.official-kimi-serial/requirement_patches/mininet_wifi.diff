@@ -0,0 +1,59 @@
+"""Mininet-WiFi network engine: extends Mininet with wireless nodes."""
+
+from .net import Mininet
+from .utils import distance_2d
+from .wifi.accesspoint import AccessPoint
+from .wifi.propagation import received_signal_strength
+from .wifi.station import Station
+
+
+class MininetWifi(Mininet):
+    """Mininet extended with WiFi stations, access points, and association."""
+
+    def __init__(self, *args, **kwargs):
+        self.stations = []
+        self.access_points = []
+        super().__init__(*args, **kwargs)
+
+    def addStation(self, name, position=(0.0, 0.0), **params):
+        sta = Station(name, position=position, **params)
+        self.stations.append(sta)
+        self.hosts.append(sta)
+        self.name_to_node[name] = sta
+        self.graph.add_node(name)
+        return sta
+
+    def addAccessPoint(self, name, position=(0.0, 0.0), **params):
+        ap = AccessPoint(name, position=position, **params)
+        self.access_points.append(ap)
+        self.switches.append(ap)
+        self.name_to_node[name] = ap
+        self.graph.add_node(name)
+        return ap
+
+    def rssi_between(self, sta, ap):
+        """Signal strength (dBm) a station would receive from an AP."""
+        distance = distance_2d(sta.position, ap.position)
+        return received_signal_strength(
+            ap.tx_power_dbm, ap.freq_ghz * 1e9, distance,
+            path_loss_exp=ap.path_loss_exp)
+
+    def auto_associate(self):
+        """Associate each station with the strongest-signal AP in range."""
+        for ap in self.access_points:
+            ap.associated_stations = []
+        for sta in self.stations:
+            best_ap = None
+            best_rssi = float("-inf")
+            for ap in self.access_points:
+                rssi = self.rssi_between(sta, ap)
+                if rssi >= ap.min_rssi_dbm and rssi > best_rssi:
+                    best_ap = ap
+                    best_rssi = rssi
+            sta.associated_ap = best_ap
+            if best_ap is not None:
+                best_ap.associated_stations.append(sta)
+
+    def count_associated(self):
+        """Number of stations currently associated with an AP."""
+        return sum(1 for sta in self.stations if sta.associated_ap is not None)
