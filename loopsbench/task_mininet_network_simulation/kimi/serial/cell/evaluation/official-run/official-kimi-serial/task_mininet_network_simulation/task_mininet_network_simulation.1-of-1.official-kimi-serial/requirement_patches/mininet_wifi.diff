+"""Signal-aware wireless link with RSSI-dependent bandwidth."""
+
+from ..link import TCLink
+from ..utils import distance_2d
+from .propagation import received_signal_strength
+
+# Simplified 802.11g rate table: (min_rssi_dbm, bandwidth_mbps)
+RSSI_BW_TABLE = [
+    (-50.0, 54.0),
+    (-60.0, 48.0),
+    (-65.0, 36.0),
+    (-70.0, 24.0),
+    (-75.0, 12.0),
+    (-80.0, 6.0),
+]
+
+
+def bandwidth_from_rssi(rssi_dbm):
+    """Map RSSI to link bandwidth using the simplified 802.11g model."""
+    for threshold, bw in RSSI_BW_TABLE:
+        if rssi_dbm >= threshold:
+            return bw
+    return 0.0
+
+
+class WirelessLink(TCLink):
+    """A wireless link whose bandwidth depends on signal strength."""
+
+    def __init__(self, sta, ap, delay=0.0, loss=0.0, **params):
+        self.rssi_dbm = self._compute_rssi(sta, ap)
+        bw = bandwidth_from_rssi(self.rssi_dbm)
+        super().__init__(sta, ap, bw=bw, delay=delay, loss=loss, **params)
+
+    @staticmethod
+    def _compute_rssi(sta, ap):
+        distance = distance_2d(sta.position, ap.position)
+        return received_signal_strength(
+            ap.tx_power_dbm, ap.freq_ghz * 1e9, distance,
+            path_loss_exp=ap.path_loss_exp)
+
+    def update(self):
+        """Recompute RSSI and bandwidth from current node positions."""
+        self.rssi_dbm = self._compute_rssi(self.node1, self.node2)
+        self.bw = bandwidth_from_rssi(self.rssi_dbm)
+        return self.bw
