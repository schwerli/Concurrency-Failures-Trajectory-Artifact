++++ b/netsim/topo.py
+@@ -0,0 +1,100 @@
++"""Topology classes for Mininet-style network emulation."""
++
++
++class Topo:
++    """Base topology: an abstract description of hosts, switches, and links."""
++
++    def __init__(self, **link_params):
++        self._hosts = []
++        self._switches = []
++        self._links = []  # list of (node1, node2, params)
++        self._node_params = {}
++        self._link_params = dict(link_params)
++
++    def addHost(self, name, **params):
++        self._hosts.append(name)
++        self._node_params[name] = dict(params)
++        return name
++
++    def addSwitch(self, name, **params):
++        self._switches.append(name)
++        self._node_params[name] = dict(params)
++        return name
++
++    def addLink(self, node1, node2, **params):
++        merged = dict(self._link_params)
++        merged.update(params)
++        self._links.append((node1, node2, merged))
++        return (node1, node2)
++
++    def hosts(self):
++        return list(self._hosts)
++
++    def switches(self):
++        return list(self._switches)
++
++    def links(self):
++        return [(n1, n2) for n1, n2, _ in self._links]
++
++    def link_params(self, node1, node2):
++        for n1, n2, params in self._links:
++            if (n1, n2) == (node1, node2) or (n1, n2) == (node2, node1):
++                return params
++        return {}
++
++    def node_info(self, name):
++        return self._node_params.get(name, {})
++
++
++class LinearTopo(Topo):
++    """k switches in a line, each with one attached host: h1-s1-s2-...-sN-hN."""
++
++    def __init__(self, k=2, **link_params):
++        super().__init__(**link_params)
++        self.k = k
++        for i in range(1, k + 1):
++            self.addSwitch(f"s{i}")
++            self.addHost(f"h{i}")
++            self.addLink(f"h{i}", f"s{i}")
++            if i > 1:
++                self.addLink(f"s{i - 1}", f"s{i}")
++
++
++class SingleSwitchTopo(Topo):
++    """One switch connected to k hosts."""
++
++    def __init__(self, k=2, **link_params):
++        super().__init__(**link_params)
++        self.k = k
++        self.addSwitch("s1")
++        for i in range(1, k + 1):
++            self.addHost(f"h{i}")
++            self.addLink(f"h{i}", "s1")
++
++
++class TreeTopo(Topo):
++    """Tree of switches with given depth and fanout; hosts at the leaves."""
++
++    def __init__(self, depth=1, fanout=2, **link_params):
++        super().__init__(**link_params)
++        self.depth = depth
++        self.fanout = fanout
++        self._host_count = 0
++        self._switch_count = 0
++        self._build_tree(parent=None, depth=depth)
++
++    def _build_tree(self, parent, depth):
++        self._switch_count += 1
++        switch = f"s{self._switch_count}"
++        self.addSwitch(switch)
++        if parent is not None:
++            self.addLink(parent, switch)
++        if depth > 1:
++            for _ in range(self.fanout):
++                self._build_tree(parent=switch, depth=depth - 1)
++        else:
++            for _ in range(self.fanout):
++                self._host_count += 1
++                host = f"h{self._host_count}"
++                self.addHost(host)
++                self.addLink(switch, host)
