++"""Mininet-style network emulation engine."""
++
++from .graph import WeightedGraph
++from .link import TCLink
++from .node import Controller, Host, OVSSwitch, Switch
++from .utils import compute_bottleneck_bw, compute_path_delay, generate_ip
++
++
++class Mininet:
++    """Builds and runs an emulated network from a topology."""
++
++    def __init__(self, topo=None, link=TCLink, switch=OVSSwitch,
++                 host=Host, controller=Controller):
++        self.topo = topo
++        self.link_cls = link
++        self.switch_cls = switch
++        self.host_cls = host
++        self.controller_cls = controller
++        self.hosts = []
++        self.switches = []
++        self.controllers = []
++        self.links = []
++        self.graph = WeightedGraph()
++        self.name_to_node = {}
++        self._host_count = 0
++        self._switch_count = 0
++        self._controller_count = 0
++        if topo is not None:
++            self.build()
++
++    def addHost(self, name, cls=None, **params):
++        cls = cls or self.host_cls
++        host = cls(name, **params)
++        self.hosts.append(host)
++        self.name_to_node[name] = host
++        self.graph.add_node(name)
++        return host
++
++    def addSwitch(self, name, cls=None, **params):
++        cls = cls or self.switch_cls
++        switch = cls(name, **params)
++        self.switches.append(switch)
++        self.name_to_node[name] = switch
++        self.graph.add_node(name)
++        return switch
++
++    def addController(self, name=None, cls=None, **params):
++        cls = cls or self.controller_cls
++        if name is None:
++            self._controller_count += 1
++            name = f"c{self._controller_count}"
++        controller = cls(name, **params)
++        self.controllers.append(controller)
++        self.name_to_node[name] = controller
++        return controller
++
++    def _node(self, node):
++        if isinstance(node, str):
++            return self.name_to_node[node]
++        return node
++
++    def addLink(self, node1, node2, cls=None, **params):
++        cls = cls or self.link_cls
++        n1 = self._node(node1)
++        n2 = self._node(node2)
++        link = cls(n1, n2, **params)
++        self.links.append(link)
++        self.graph.add_edge(n1.name, n2.name,
++                            bw=link.bw, delay=link.delay, loss=link.loss)
++        return link
++
++    def build(self):
++        """Build the network from the assigned topology."""
++        self.addController()
++        for switch_name in self.topo.switches():
++            self.addSwitch(switch_name, **self.topo.node_info(switch_name))
++        for host_name in self.topo.hosts():
++            self.addHost(host_name, **self.topo.node_info(host_name))
++        for n1, n2 in self.topo.links():
++            self.addLink(n1, n2, **self.topo.link_params(n1, n2))
++
++    def start(self):
++        """Assign IP addresses to hosts."""
++        for i, host in enumerate(self.hosts):
++            host.ip = generate_ip(i)
++
++    def _resolve_hosts(self, hosts):
++        if hosts is None:
++            return list(self.hosts)
++        return [self._node(h) for h in hosts]
++
++    def ping(self, hosts=None):
++        """Simulate ping between all pairs; return loss percentage."""
++        hosts = self._resolve_hosts(hosts)
++        if len(hosts) < 2:
++            return 0.0
++        total = 0
++        lost = 0
++        for i, src in enumerate(hosts):
++            for dst in hosts[i + 1:]:
++                total += 1
++                path = self.graph.shortest_path(src.name, dst.name)
++                if path is None:
++                    lost += 1
++        return 100.0 * lost / total
++
++    def pingAll(self):
++        """Ping between all hosts; return loss percentage."""
++        return self.ping(self.hosts)
++
++    def _path_edge_attrs(self, path, attr):
++        values = []
++        for u, v in zip(path, path[1:]):
++            values.append(self.graph.get_edge(u, v).get(attr))
++        return values
++
++    def iperf(self, hosts=None):
++        """Simulate a bandwidth measurement between two hosts.
++
++        Finds the shortest path, computes the bottleneck bandwidth, and
++        applies a per-switch forwarding overhead to each switch hop.
++        Returns throughput in Mbps.
++        """
++        hosts = self._resolve_hosts(hosts)
++        if len(hosts) < 2:
++            return 0.0
++        src, dst = hosts[0], hosts[-1]
++        path = self.graph.shortest_path(src.name, dst.name)
++        if path is None:
++            return 0.0
++        bandwidths = [bw for bw in self._path_edge_attrs(path, "bw")
++                      if bw is not None]
++        bottleneck = compute_bottleneck_bw(bandwidths)
++        num_switches = sum(1 for n in path
++                           if isinstance(self.name_to_node.get(n), Switch))
++        return bottleneck * (1.0 - Switch.FORWARDING_OVERHEAD) ** num_switches
++
++    def avg_rtt(self, hosts=None):
++        """Average round-trip time (ms) across all host pairs."""
++        hosts = self._resolve_hosts(hosts)
++        if len(hosts) < 2:
++            return 0.0
++        rtts = []
++        for i, src in enumerate(hosts):
++            for dst in hosts[i + 1:]:
++                path = self.graph.shortest_path(src.name, dst.name)
++                if path is None:
++                    continue
++                delays = [d for d in self._path_edge_attrs(path, "delay")
++                          if d is not None]
++                rtts.append(2.0 * compute_path_delay(delays))
++        if not rtts:
++            return 0.0
++        return sum(rtts) / len(rtts)
