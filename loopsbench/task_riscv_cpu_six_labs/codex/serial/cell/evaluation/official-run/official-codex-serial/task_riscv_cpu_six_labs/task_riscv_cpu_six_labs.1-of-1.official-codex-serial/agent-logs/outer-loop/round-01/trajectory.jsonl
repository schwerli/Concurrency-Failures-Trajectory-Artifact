{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc 'for f in /workspace/repo/src/lab1/common/MUX2T1_32.v /workspace/repo/src/lab1/common/MUX4T1_32.v /workspace/repo/src/lab1/common/REG32.v /workspace/repo/src/lab1/common/add_32.v; do echo \"--- ${f##/workspace/repo/} ---\"; sed -n '\"'1,160p' \\\"\"'$f\"; echo; done'","aggregated_output":"--- src/lab1/common/MUX2T1_32.v ---\n`timescale 1ns / 1ps\n//////////////////////////////////////////////////////////////////////////////////\n// Company: \n// Engineer: \n// \n// Create Date: 2020/11/09 15:27:41\n// Design Name: \n// Module Name: MUX2T1_32\n// Project Name: \n// Target Devices: \n// Tool Versions: \n// Description: \n// \n// Dependencies: \n// \n// Revision:\n// Revision 0.01 - File Created\n// Additional Comments:\n// \n//////////////////////////////////////////////////////////////////////////////////\n\n\nmodule MUX2T1_32(input[31:0]I0,\n\t\t\t\t input[31:0]I1,\n\t\t\t\t input s,\n\t\t\t\t output[31:0]o\n\n    );\n    assign o = s ? I1 : I0;\nendmodule\n\n--- src/lab1/common/MUX4T1_32.v ---\n`timescale 1ns / 1ps\n//////////////////////////////////////////////////////////////////////////////////\n// Company: \n// Engineer: \n// \n// Create Date: 2020/11/09 15:47:19\n// Design Name: \n// Module Name: MUX4T1_32\n// Project Name: \n// Target Devices: \n// Tool Versions: \n// Description: \n// \n// Dependencies: \n// \n// Revision:\n// Revision 0.01 - File Created\n// Additional Comments:\n// \n//////////////////////////////////////////////////////////////////////////////////\n\n\nmodule MUX4T1_32(\n    input [1:0]s,\n    input [31:0]I0, I1, I2, I3,\n    output [31:0]o\n    );\n\n    wire s0 = s == 2'b00;\n    wire s1 = s == 2'b01;\n    wire s2 = s == 2'b10;\n    wire s3 = s == 2'b11;\n    \n    assign o =  {32{s0}} & I0 |\n                {32{s1}} & I1 |\n                {32{s2}} & I2 |\n                {32{s3}} & I3 ;\nendmodule\n\n--- src/lab1/common/REG32.v ---\n`timescale 1ns / 1ps\n//////////////////////////////////////////////////////////////////////////////////\n// Company: \n// Engineer: \n// \n// Create Date: 2021/02/18 12:57:09\n// Design Name: \n// Module Name: REG32\n// Project Name: \n// Target Devices: \n// Tool Versions: \n// Description: \n// \n// Dependencies: \n// \n// Revision:\n// Revision 0.01 - File Created\n// Additional Comments:\n// \n//////////////////////////////////////////////////////////////////////////////////\n\n\nmodule REG32(\n                    input clk,\n\t\t\t\t\tinput rst,\n\t\t\t\t\tinput CE,\n\t\t\t\t\tinput [31:0]D,\n\t\t\t\t\toutput reg[31:0]Q\n\t\t\t\t\t);\n\t\t\t\t\t\n\talways @(posedge clk or posedge rst)\n\t\tif (rst)  Q <= 32'h00000000;\n\t\telse if (CE) Q <= D;\n\nendmodule\n\n--- src/lab1/common/add_32.v ---\n`timescale 1ns / 1ps\n//////////////////////////////////////////////////////////////////////////////////\n// Company: \n// Engineer: \n// \n// Create Date: 2020/11/09 16:03:56\n// Design Name: \n// Module Name: add_32\n// Project Name: \n// Target Devices: \n// Tool Versions: \n// Description: \n// \n// Dependencies: \n// \n// Revision:\n// Revision 0.01 - File Created\n// Additional Comments:\n// \n//////////////////////////////////////////////////////////////////////////////////\n\n\nmodule add_32(    input [31:0] a, \n\t\t\t\t  input [31:0] b, \n\t\t\t\t  output [31:0]c\n\n\n    );\n    assign c=a+b;\nendmodule\n\n","exit_code":0,"status":"completed"}}
