 parameter Imm_type_J = 3'b011;\n    90\t    parameter Imm_type_S = 3'b100;\n    91\t    parameter Imm_type_U = 3'b101;\n    92\t\n    93\t    parameter cmp_EQ  = 3'b001;\n    94\t    parameter cmp_NE  = 3'b010;\n    95\t    parameter cmp_LT  = 3'b011;\n    96\t    parameter cmp_LTU = 3'b100;\n    97\t    parameter cmp_GE  = 3'b101;\n    98\t    parameter cmp_GEU = 3'b110;\n    99\t\n   100\t    parameter ALU_ADD  = 4'b0001;\n   101\t    parameter ALU_SUB  = 4'b0010;\n   102\t    parameter ALU_AND  = 4'b0011;\n   103\t    parameter ALU_OR   = 4'b0100;\n   104\t    parameter ALU_XOR  = 4'b0101;\n   105\t    parameter ALU_SLL  = 4'b0110;\n   106\t    parameter ALU_SRL  = 4'b0111;\n   107\t    parameter ALU_SLT  = 4'b1000;\n   108\t    parameter ALU_SLTU = 4'b1001;\n   109\t    parameter ALU_SRA  = 4'b1010;\n   110\t    parameter ALU_Ap4  = 4'b1011;\n   111\t    parameter ALU_Bout = 4'b1100;\n   112\t\n   113\t    parameter hazard_optype_ALU = 2'd1;\n   114\t    parameter hazard_optype_LOAD = 2'd2;\n   115\t    parameter hazard_optype_STORE = 2'd3;\n   116\t\n   117\t    // TODO: implement — assign Branch output\n   118\t    assign Branch = 1'b0;\n   119\t\n   120\t    // TODO: implement — assign ImmSel output based on instruction type\n   121\t    assign ImmSel = 3'b0;\n   122\t\n   123\t    // TODO: implement — assign cmp_ctrl output for branch comparisons\n   124\t    assign cmp_ctrl = 3'b0;\n   125\t\n   126\t    // TODO: implement — assign ALUSrc_A output\n   127\t    assign ALUSrc_A = 1'b0;\n   128\t\n   129\t    // TODO: implement — assign ALUSrc_B output\n   130\t    assign ALUSrc_B = 1'b0;\n   131\t\n   132\t    // TODO: implement — assign ALUControl output based on instruction\n   133\t    assign ALUControl = 4'b0;\n   134\t\n   135\t    // TODO: implement — assign DatatoReg output\n   136\t    assign DatatoReg = 1'b0;\n   137\t\n   138\t    // TODO: implement — assign RegWrite output\n   139\t    assign RegWrite = 1'b0;\n   140\t\n   141\t    // TODO: implement — assign mem_w output\n   142\t    assign mem_w = 1'b0;\n   143\t\n   144\t    // TODO: implement — assign MIO output\n   145\t    assign MIO = 1'b0;\n   146\t\n   147\t    // TODO: implement — assign rs1use output\n   148\t    assign rs1use = 1'b0;\n   149\t\n   150\t    // TODO: implement — assign rs2use output\n   151\t    assign rs2use = 1'b0;\n   152\t\n   153\t    // TODO: implement — assign hazard_optype output\n   154\t    assign hazard_optype = 2'b0;\n   155\t\n   156\tendmodule\n\n--- src/lab4/core/HazardDetectionUnit.v ---\n     1\t`timescale 1ps/1ps\n     2\t\n     3\tmodule HazardDetectionUnit(\n     4\t    input clk,\n     5\t    input Branch_ID, rs1use_ID, rs2use_ID,\n     6\t    input[1:0] hazard_optype_ID,\n     7\t    input[4:0] rd_EXE, rd_MEM, rs1_ID, rs2_ID, rs2_EXE,\n     8\t    input cmu_stall,\n     9\t    output PC_EN_IF, reg_FD_EN, reg_FD_stall, reg_FD_flush,\n    10\t        reg_DE_EN, reg_DE_flush, reg_EM_EN, reg_EM_flush, reg_MW_EN,\n    11\t    output forward_ctrl_ls,\n    12\t    output[1:0] forward_ctrl_A, forward_ctrl_B\n    13\t);\n    14\t\n    15\t    assign reg_FD_EN = ~cmu_stall;\n    16\t    assign reg_DE_EN = ~cmu_stall;\n    17\t    assign reg_EM_EN = ~cmu_stall;\n    18\t    assign reg_MW_EN = ~cmu_stall;\n    19\t    assign reg_EM_flush = 0;\n    20\t\n    21\t    reg[1:0] hazard_optype_EXE, hazard_optype_MEM;\n    22\t    always@(posedge clk) begin\n    23\t        hazard_optype_MEM <= hazard_optype_EXE & {2{~reg_EM_flush}};\n    24\t        hazard_optype_EXE <= hazard_optype_ID & {2{~reg_DE_flush}};\n    25\t    end\n    26\t\n    27\t    parameter hazard_optype_ALU = 2'd1;\n    28\t    parameter hazard_optype_LOAD = 2'd2;\n    29\t    parameter hazard_optype_STORE = 2'd3;\n    30\t\n    31\t    // TODO: implement — detect forwarding conditions and load-use hazards\n    32\t    // Compute rs1_forward_*, rs2_forward_*, load_stall, and assign outputs\n    33\t\n    34\t    assign PC_EN_IF = ~cmu_stall;\n    35\t    assign reg_FD_stall = 1'b0;\n    36\t    assign reg_FD_flush = 1'b0;\n    37\t    assign reg_DE_flush = 1'b0;\n    38\t\n    39\t    assign forward_ctrl_A = 2'b0;\n    40\t    assign forward_ctrl_B = 2'b0;\n    41\t\n    42\t    assign forward_ctrl_ls = 1'b0;\n    43\t\n    44\tendmodule\n\n--- src/lab4/core/RV32core.v ---\n     1\t`timescale 1ns / 1ps\n     2\t\n     3\t\n     4\tmodule  RV32core(\n     5\t        input debug_en,  // debug enable\n     6\t        input debug_step,  // debug step clock\n     7\t        input [6:0] debug_addr,  // debug address\n     8\t        output[31:0] debug_data,  // debug data\n     9\t        output[31:0] wb_pc,\n    10\t        output[31:0] wb_inst,\n    11\t        output[31:0] mem_addr,\n    12\t        output[31:0] mem_data,\n    13\t        input clk,  // main clock\n    14\t        input rst,  // synchronous reset\n    15\t        input interrupter  // interrupt source, for future use\n    16\t\t);\n    17\t\n    18\t\twire debug_clk;\n    19\t\n    20\t\tdebug_clk clock(.clk(clk),.debug_en(debug_en),.debug_step(debug_step),.debug_clk(debug_clk));\n    21\t\n    22\t    wire Branch_ctrl, JALR, RegWrite_ctrl, mem_w_ctrl, MIO_ctrl,\n    23\t        ALUSrc_A_ctrl, ALUSrc_B_ctrl, DatatoReg_ctrl, rs1use_ctrl, rs2use_ctrl;\n    24\t    wire[1:0] hazard_optype_ctrl;\n    25\t    wire[2:0] ImmSel_ctrl, cmp_ctrl;\n    26\t    wire[3:0] ALUControl_ctrl;\n    27\t\n    28\t    wire forward_ctrl_ls;\n    29\t    wire[1:0] forward_ctrl_A, forward_ctrl_B;\n    30\t\n    31\t\twire PC_EN_IF;\n    32\t\twire [31:0] PC_IF, next_PC_IF, PC_4_IF, inst_IF;\n    33\t\n    34\t    wire reg_FD_EN,reg_FD_stall,reg_FD_flush, cmp_res_ID;\n    35\t    wire [31:0] jump_PC_ID, PC_ID, inst_ID, Debug_regs, rs1_data_reg, rs2_data_reg,\n    36\t        Imm_out_ID, rs1_data_ID, rs2_data_ID, addA_ID;\n    37\t    \n    38\t    wire reg_DE_EN, reg_DE_flush, RegWrite_EXE, mem_w_EXE, MIO_EXE,\n    39\t        ALUSrc_A_EXE, ALUSrc_B_EXE, ALUzero_EXE, ALUoverflow_E