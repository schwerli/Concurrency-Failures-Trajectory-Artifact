+++ b/stream/sam_knn.py
@@ -0,0 +1,500 @@
+"""SAM-KNN: k nearest neighbours with a Self Adjusting Memory.
+
+Reference: Losing, Hammer & Wersing, "KNN Classifier with Self Adjusting Memory
+for Heterogeneous Concept Drift", ICDM 2016.
+
+The model keeps two memories:
+
+* the **Short Term Memory** (STM) - a sliding window of the most recent
+  instances, which follows the current concept and forgets quickly,
+* the **Long Term Memory** (LTM) - instances evicted from the STM that do not
+  contradict the current concept, compressed into prototypes when it overflows.
+
+Both memories answer with a kNN vote.  For every query the memory with the
+higher local accuracy decides, so the model can switch between "react fast"
+(STM) and "remember old knowledge" (LTM) behaviour, which is what makes it
+robust against heterogeneous drift.
+"""
+
+import heapq
+import math
+from itertools import repeat
+from typing import Dict, List, Optional, Sequence, Tuple
+
+Features = Sequence[float]
+
+
+# ----------------------------------------------------------------------
+# distance helpers
+# ----------------------------------------------------------------------
+def euclidean_distance(a: Features, b: Features,
+                       weights: Optional[Sequence[float]] = None) -> float:
+    """Euclidean distance ``sqrt(sum((a - b)^2))`` with optional weighting."""
+    if weights is None:
+        return math.dist(a, b)
+    return math.sqrt(sum(w * (x - y) * (x - y) for w, x, y in zip(weights, a, b)))
+
+
+def knn_search(features: List[Features], labels: List[int], query: Features,
+               k: int, weights: Optional[Sequence[float]] = None,
+               exclude_index: Optional[int] = None) -> List[Tuple[float, int]]:
+    """Return the ``k`` closest ``(distance, index)`` pairs, nearest first."""
+    if not features or k <= 0:
+        return []
+    if weights is None:
+        # math.dist over a C level map is the hot loop of the whole model
+        distances = list(map(math.dist, features, repeat(query)))
+    else:
+        distances = [euclidean_distance(stored, query, weights) for stored in features]
+    if exclude_index is not None and 0 <= exclude_index < len(distances):
+        distances[exclude_index] = float('inf')
+    if k >= len(distances):
+        return sorted(zip(distances, range(len(distances))))
+    nearest = heapq.nsmallest(k, range(len(distances)), key=distances.__getitem__)
+    return [(distances[i], i) for i in nearest]
+
+
+def knn_vote(features: List[Features], labels: List[int], query: Features, k: int,
+             weights: Optional[Sequence[float]] = None,
+             exclude_index: Optional[int] = None) -> Optional[int]:
+    """Majority label of the ``k`` nearest neighbours (``None`` if empty).
+
+    Ties between classes are broken by the smaller neighbour distance and then
+    by the smaller class label, which keeps predictions deterministic.
+    """
+    neighbours = knn_search(features, labels, query, k, weights, exclude_index)
+    if not neighbours:
+        return None
+    votes: Dict[int, int] = {}
+    closest: Dict[int, float] = {}
+    for distance, index in neighbours:
+        if distance == float('inf'):
+            continue
+        label = labels[index]
+        votes[label] = votes.get(label, 0) + 1
+        if label not in closest or distance < closest[label]:
+            closest[label] = distance
+    if not votes:
+        return None
+    return min(votes, key=lambda label: (-votes[label], closest[label], label))
+
+
+# ----------------------------------------------------------------------
+# memories
+# ----------------------------------------------------------------------
+class ShortTermMemory:
+    """FIFO sliding window of the most recent instances."""
+
+    def __init__(self, max_size: int = 5000,
+                 feature_weights: Optional[Sequence[float]] = None):
+        self.max_size = max_size
+        self.feature_weights = feature_weights
+        self.features: List[List[float]] = []
+        self.labels: List[int] = []
+
+    def add(self, features: Features, label: int
+            ) -> Optional[Tuple[List[float], int]]:
+        """Append an instance; return the evicted one when the window is full."""
+        evicted = None
+        self.features.append(list(features))
+        self.labels.append(int(label))
+        if len(self.features) > self.max_size:
+            evicted = (self.features.pop(0), self.labels.pop(0))
+        return evicted
+
+    def knn_predict(self, query: Features, k: int = 5,
+                    exclude_index: Optional[int] = None) -> Optional[int]:
+        return knn_vote(self.features, self.labels, query, k,
+                        self.feature_weights, exclude_index)
+
+    def get_size(self) -> int:
+        return len(self.features)
+
+    def get_window(self) -> Tuple[List[List[float]], List[int]]:
+        """The stored ``(features, labels)`` in arrival order."""
+        return self.features, self.labels
+
+    def clear(self):
+        self.features = []
+        self.labels = []
+
+    def __len__(self) -> int:
+        return len(self.features)
+
+    def __repr__(self) -> str:
+        return f"ShortTermMemory(size={len(self.features)}/{self.max_size})"
+
+
+class LongTermMemory:
+    """Compressed store of knowledge that is still consistent with the stream."""
+
+    def __init__(self, max_size: int = 10000, min_cluster_size: int = 10,
+                 feature_weights: Optional[Sequence[float]] = None,
+                 max_kmeans_iterations: int = 5,
+                 distance_budget: int = 2_000_000):
+        self.max_size = max_size
+        self.min_cluster_size = max(1, min_cluster_size)
+        self.feature_weights = feature_weights
+        self.max_kmeans_iterations = max_kmeans_iterations
+        #: soft cap on the number of distance evaluations spent per compression
+        self.distance_budget = distance_budget
+        self.features: List[List[float]] = []
+        self.labels: List[int] = []
+        self.num_cleaned = 0
+        self.num_compressions = 0
+
+    # -- basic operations --------------------------------------------------
+    def add(self, features: Features, label: int):
+        self.features.append(list(features))
+        self.labels.append(int(label))
+        if len(self.features) > self.max_size:
+            self.compress()
+            # compression may not be able to free anything (e.g. tiny classes)
+            while len(self.features) > self.max_size:
+                self.features.pop(0)
+                self.labels.pop(0)
+
+    def knn_predict(self, query: Features, k: int = 5) -> Optional[int]:
+        return knn_vote(self.features, self.labels, query, k, self.feature_weights)
+
+    def get_size(self) -> int:
+        return len(self.features)
+
+    def clear(self):
+        self.features = []
+        self.labels = []
+
+    def __len__(self) -> int:
+        return len(self.features)
+
+    def __repr__(self) -> str:
+        return f"LongTermMemory(size={len(self.features)}/{self.max_size})"
+
+    # -- cleaning ----------------------------------------------------------
+    def clean(self, stm_features: List[Features], stm_labels: List[int],
+              k: int = 5) -> int:
+        """Drop instances that the current concept (the STM) contradicts.
+
+        An instance is contradicted when the kNN prediction obtained from the
+        STM disagrees with the label stored in the LTM.  Returns the number of
+        removed instances.
+        """
+        if not self.features or not stm_features:
+            return 0
+        kept_features: List[List[float]] = []
+        kept_labels: List[int] = []
+        for stored, label in zip(self.features, self.labels):
+            prediction = knn_vote(stm_features, stm_labels, stored, k,
+                                  self.feature_weights)
+            if prediction is None or prediction == label:
+                kept_features.append(stored)
+                kept_labels.append(label)
+        removed = len(self.features) - len(kept_features)
+        self.features = kept_features
+        self.labels = kept_labels
+        self.num_cleaned += removed
+        return removed
+
+    # -- compression -------------------------------------------------------
+    def compress(self, target_size: Optional[int] = None) -> int:
+        """Replace groups of instances of one class by their centroid.
+
+        Clustering is done per class with k-means, using roughly
+        ``min_cluster_size`` instances per cluster.  Returns the number of
+        instances removed by the compression.
+        """
+        if not self.features:
+            return 0
+        size_before = len(self.features)
+        if target_size is None:
+            target_size = max(1, self.max_size // 2)
+        if size_before <= target_size:
+            return 0
+
+        by_class: Dict[int, List[int]] = {}
+        for index, label in enumerate(self.labels):
+            by_class.setdefault(label, []).append(index)
+
+        new_features: List[List[float]] = []
+        new_labels: List[int] = []
+        for label, indices in sorted(by_class.items()):
+            members = [self.features[i] for i in indices]
+            if len(members) <= self.min_cluster_size:
+                new_features.extend(members)
+                new_labels.extend([label] * len(members))
+                continue
+            share = max(1, int(round(target_size * len(members) / float(size_before))))
+            num_clusters = min(len(members),
+                               max(1, min(share, len(members) // self.min_cluster_size)))
+            centroids = self._kmeans(members, num_clusters)
+            new_features.extend(centroids)
+            new_labels.extend([label] * len(centroids))
+
+        self.features = new_features
+        self.labels = new_labels
+        self.num_compressions += 1
+        return size_before - len(self.features)
+
+    def _kmeans(self, points: List[List[float]], num_clusters: int) -> List[List[float]]:
+        """Deterministic Lloyd's algorithm; returns the cluster centroids."""
+        num_points = len(points)
+        if num_clusters >= num_points:
+            return [list(p) for p in points]
+        if num_clusters <= 1:
+            return [self._centroid(points)]
+        # evenly spaced seeds keep the initialisation deterministic
+        step = num_points / float(num_clusters)
+        centroids = [list(points[min(num_points - 1, int(i * step))])
+                     for i in range(num_clusters)]
+        pairs_per_iteration = max(1, num_points * num_clusters)
+        iterations = max(1, min(self.max_kmeans_iterations,
+                                self.distance_budget // pairs_per_iteration))
+        distance = math.dist
+        assignment = [0] * num_points
+        for _ in range(iterations):
+            changed = False
+            for i, point in enumerate(points):
+                best, best_distance = 0, float('inf')
+                for c, centroid in enumerate(centroids):
+                    d = distance(point, centroid)
+                    if d < best_distance:
+                        best, best_distance = c, d
+                if assignment[i] != best:
+                    assignment[i] = best
+                    changed = True
+            groups: Dict[int, List[List[float]]] = {}
+            for i, cluster in enumerate(assignment):
+                groups.setdefault(cluster, []).append(points[i])
+            centroids = [self._centroid(groups[c]) for c in sorted(groups)]
+            if not changed:
+                break
+        return centroids
+
+    @staticmethod
+    def _centroid(points: List[List[float]]) -> List[float]:
+        count = float(len(points))
+        dimensions = len(points[0])
+        centroid = [0.0] * dimensions
+        for point in points:
+            for d in range(dimensions):
+                centroid[d] += point[d]
+        return [value / count for value in centroid]
+
+
+# ----------------------------------------------------------------------
+# the classifier
+# ----------------------------------------------------------------------
+class SAMModel:
+    """kNN classifier with a self adjusting memory (STM + LTM).
+
+    Args:
+        k: number of neighbours.
+        stm_max_size: capacity of the short term memory.
+        ltm_max_size: capacity of the long term memory.
+        min_stm_size: STM instances required before the LTM may take over.
+        ltm_clean_frequency: instances between two LTM cleaning passes.
+        validation_size: number of recent STM instances used to estimate the
+            local accuracy of each memory.
+        evaluation_frequency: instances between two memory evaluations; the
+            weights are reused in between (the memories change slowly, and a
+            full evaluation costs ``validation_size * (|STM| + |LTM|)``
+            distance computations).
+        local_evaluation: when True the validation window is formed by the STM
+            instances closest to the query instead of the most recent ones.
+    """
+
+    def __init__(self, k: int = 5, stm_max_size: int = 5000,
+                 ltm_max_size: int = 10000, min_stm_size: int = 50,
+                 ltm_clean_frequency: int = 500, validation_size: int = 20,
+                 evaluation_frequency: int = 100, min_cluster_size: int = 10,
+                 feature_weights: Optional[Sequence[float]] = None,
+                 local_evaluation: bool = False):
+        self.k = k
+        self.min_stm_size = min_stm_size
+        self.ltm_clean_frequency = max(1, ltm_clean_frequency)
+        self.validation_size = max(1, validation_size)
+        self.evaluation_frequency = max(1, evaluation_frequency)
+        self.local_evaluation = local_evaluation
+        self.feature_weights = feature_weights
+        self.stm = ShortTermMemory(max_size=stm_max_size,
+                                   feature_weights=feature_weights)
+        self.ltm = LongTermMemory(max_size=ltm_max_size,
+                                  min_cluster_size=min_cluster_size,
+                                  feature_weights=feature_weights)
+        self.instances_seen = 0
+        self.stm_decisions = 0
+        self.ltm_decisions = 0
+        self._weights_age = -1
+        self._memory_accuracies: Tuple[float, float] = (1.0, 0.0)
+        self.last_prediction_details: Dict[str, object] = {}
+
+    # -- helpers -----------------------------------------------------------
+    @staticmethod
+    def _as_features(instance) -> Features:
+        """Accept both raw feature lists and :class:`streams.Instance`."""
+        return getattr(instance, "features", instance)
+
+    # -- learning ----------------------------------------------------------
+    def partial_fit(self, features, label: Optional[int] = None):
+        """Add one labelled instance to the memories."""
+        if label is None:
+            label = getattr(features, "label", None)
+            if label is None:
+                raise ValueError("a label is required")
+        features = self._as_features(features)
+        self.instances_seen += 1
+
+        evicted = self.stm.add(features, label)
+        if evicted is not None:
+            # instances leaving the STM are preserved as long term knowledge
+            self.ltm.add(evicted[0], evicted[1])
+
+        if self.instances_seen % self.ltm_clean_frequency == 0 and self.ltm.get_size():
+            stm_features, stm_labels = self.stm.get_window()
+            self.ltm.clean(stm_features, stm_labels, self.k)
+            if self.ltm.get_size() > self.ltm.max_size:
+                self.ltm.compress()
+            # the LTM changed substantially, so re-weight the memories
+            self._weights_age = -1
+
+    def train(self, instance, weight: float = 1.0):
+        """Adapter so the model can be used by the prequential evaluators."""
+        self.partial_fit(instance)
+
+    def fit(self, features_list, labels):
+        for features, label in zip(features_list, labels):
+            self.partial_fit(features, label)
+        return self
+
+    # -- memory evaluation -------------------------------------------------
+    def _validation_window(self, query: Optional[Features]
+                           ) -> List[Tuple[int, List[float], int]]:
+        """``(stm_index, features, label)`` of the validation instances."""
+        features, labels = self.stm.get_window()
+        size = len(features)
+        if size == 0:
+            return []
+        count = min(self.validation_size, size)
+        if self.local_evaluation and query is not None:
+            neighbours = knn_search(features, labels, query, count,
+                                    self.feature_weights)
+            return [(index, features[index], labels[index])
+                    for _distance, index in neighbours]
+        start = size - count
+        return [(index, features[index], labels[index])
+                for index in range(start, size)]
+
+    def _evaluate_memories(self, query: Optional[Features] = None,
+                           k: Optional[int] = None) -> Tuple[float, float]:
+        """Local accuracy of the STM-kNN and of the LTM-kNN.
+
+        Both memories are asked to label the instances of the validation window
+        (the most recent STM instances, or the ones closest to ``query`` when
+        ``local_evaluation`` is on).  The STM is evaluated leave-one-out so that
+        an instance cannot predict itself.
+        """
+        k = k or self.k
+        window = self._validation_window(query)
+        if not window:
+            return (1.0, 0.0)
+        stm_features, stm_labels = self.stm.get_window()
+        stm_correct = 0
+        ltm_correct = 0
+        ltm_available = self.ltm.get_size() > 0
+        for index, features, label in window:
+            if self.stm.get_size() > 1:
+                prediction = knn_vote(stm_features, stm_labels, features, k,
+                                      self.feature_weights, exclude_index=index)
+                stm_correct += int(prediction == label)
+            if ltm_available:
+                ltm_correct += int(self.ltm.knn_predict(features, k) == label)
+        size = float(len(window))
+        stm_accuracy = stm_correct / size
+        ltm_accuracy = (ltm_correct / size) if ltm_available else 0.0
+        return (stm_accuracy, ltm_accuracy)
+
+    def _memory_accuracies_for(self, query: Features) -> Tuple[float, float]:
+        """Cached wrapper around :meth:`_evaluate_memories`."""
+        stale = (self._weights_age < 0
+                 or self.instances_seen - self._weights_age >= self.evaluation_frequency)
+        if stale or self.local_evaluation:
+            self._memory_accuracies = self._evaluate_memories(query, self.k)
+            self._weights_age = self.instances_seen
+        return self._memory_accuracies
+
+    # -- prediction --------------------------------------------------------
+    def predict_detailed(self, features) -> Dict[str, object]:
+        """Predict and expose which memory was used and why."""
+        features = self._as_features(features)
+        stm_prediction = self.stm.knn_predict(features, self.k)
+        ltm_prediction = (self.ltm.knn_predict(features, self.k)
+                          if self.ltm.get_size() else None)
+        stm_accuracy, ltm_accuracy = self._memory_accuracies_for(features)
+
+        use_stm = True
+        if stm_prediction is None:
+            use_stm = False
+        elif self.stm.get_size() < self.min_stm_size:
+            use_stm = True  # too little evidence to trust the long term memory
+        elif ltm_prediction is not None and ltm_accuracy > stm_accuracy:
+            use_stm = False
+
+        if use_stm and stm_prediction is not None:
+            prediction, memory = stm_prediction, "STM"
+            self.stm_decisions += 1
+        elif ltm_prediction is not None:
+            prediction, memory = ltm_prediction, "LTM"
+            self.ltm_decisions += 1
+        else:
+            prediction, memory = (stm_prediction if stm_prediction is not None else 0), "STM"
+            self.stm_decisions += 1
+
+        self.last_prediction_details = {
+            "prediction": prediction,
+            "memory": memory,
+            "stm_prediction": stm_prediction,
+            "ltm_prediction": ltm_prediction,
+            "stm_accuracy": stm_accuracy,
+            "ltm_accuracy": ltm_accuracy,
+        }
+        return self.last_prediction_details
+
+    def predict(self, features) -> int:
+        """Class prediction of the memory with the higher local accuracy."""
+        return int(self.predict_detailed(features)["prediction"])
+
+    def get_votes(self, instance) -> Dict[int, float]:
+        return {self.predict(instance): 1.0}
+
+    # -- statistics --------------------------------------------------------
+    def get_memory_sizes(self) -> Dict[str, int]:
+        return {
+            "stm": self.stm.get_size(),
+            "ltm": self.ltm.get_size(),
+            "total": self.stm.get_size() + self.ltm.get_size(),
+        }
+
+    def get_memory_decisions(self) -> Dict[str, float]:
+        total = self.stm_decisions + self.ltm_decisions
+        return {
+            "stm_decisions": self.stm_decisions,
+            "ltm_decisions": self.ltm_decisions,
+            "stm_fraction": (self.stm_decisions / total) if total else 0.0,
+        }
+
+    def reset(self):
+        self.stm.clear()
+        self.ltm.clear()
+        self.instances_seen = 0
+        self.stm_decisions = 0
+        self.ltm_decisions = 0
+        self._weights_age = -1
+        self._memory_accuracies = (1.0, 0.0)
+
+    def __repr__(self) -> str:
+        sizes = self.get_memory_sizes()
+        return f"SAMModel(k={self.k}, stm={sizes['stm']}, ltm={sizes['ltm']})"
+
+
+# convenience alias mirroring the paper's name
+SAMKNN = SAMModel
