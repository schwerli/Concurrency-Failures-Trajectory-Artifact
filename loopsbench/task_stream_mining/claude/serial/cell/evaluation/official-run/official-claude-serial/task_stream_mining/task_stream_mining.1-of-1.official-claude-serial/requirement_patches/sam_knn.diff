+"""Tests for the SAM-KNN classifier (STM / LTM self adjusting memory)."""
+
+import math
+import os
+import random
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from stream.experiments.sam_exp import AbruptDriftStream, SAMKNNExperiment
+from stream.sam_knn import (LongTermMemory, SAMKNN, SAMModel, ShortTermMemory,
+                            euclidean_distance, knn_search, knn_vote)
+
+
+class TestDistances(unittest.TestCase):
+
+    def test_euclidean(self):
+        self.assertAlmostEqual(euclidean_distance([0.0, 0.0], [3.0, 4.0]), 5.0)
+        self.assertAlmostEqual(euclidean_distance([1.0], [1.0]), 0.0)
+
+    def test_weighted_euclidean(self):
+        self.assertAlmostEqual(euclidean_distance([0.0, 0.0], [3.0, 4.0], [1.0, 0.0]), 3.0)
+        self.assertAlmostEqual(euclidean_distance([0.0, 0.0], [1.0, 1.0], [4.0, 0.0]), 2.0)
+
+    def test_knn_search_orders_by_distance(self):
+        features = [[0.0], [10.0], [1.0], [5.0]]
+        labels = [0, 1, 0, 1]
+        neighbours = knn_search(features, labels, [0.5], 3)
+        self.assertEqual([index for _distance, index in neighbours], [0, 2, 3])
+        self.assertAlmostEqual(neighbours[0][0], 0.5)
+
+    def test_knn_search_can_exclude_an_index(self):
+        features = [[0.0], [1.0], [2.0]]
+        labels = [0, 1, 2]
+        neighbours = knn_search(features, labels, [0.0], 1, exclude_index=0)
+        self.assertEqual(neighbours[0][1], 1)
+
+    def test_knn_vote_majority_and_ties(self):
+        features = [[0.0], [0.1], [5.0], [5.1]]
+        labels = [0, 0, 1, 1]
+        self.assertEqual(knn_vote(features, labels, [0.05], 3), 0)
+        self.assertEqual(knn_vote(features, labels, [5.05], 3), 1)
+        # 2 vs 2 tie: the class with the closest neighbour wins
+        self.assertEqual(knn_vote(features, labels, [0.2], 4), 0)
+        self.assertIsNone(knn_vote([], [], [0.0], 3))
+
+
+class TestShortTermMemory(unittest.TestCase):
+
+    def test_fifo_eviction(self):
+        memory = ShortTermMemory(max_size=3)
+        self.assertIsNone(memory.add([0.0], 0))
+        memory.add([1.0], 1)
+        memory.add([2.0], 0)
+        self.assertEqual(memory.get_size(), 3)
+        evicted = memory.add([3.0], 1)
+        self.assertEqual(evicted, ([0.0], 0))
+        self.assertEqual(memory.get_size(), 3)
+        features, labels = memory.get_window()
+        self.assertEqual(features, [[1.0], [2.0], [3.0]])
+        self.assertEqual(labels, [1, 0, 1])
+
+    def test_knn_predict(self):
+        memory = ShortTermMemory(max_size=10)
+        for value in (0.0, 0.1, 0.2):
+            memory.add([value], 0)
+        for value in (9.0, 9.1, 9.2):
+            memory.add([value], 1)
+        self.assertEqual(memory.knn_predict([0.15], 3), 0)
+        self.assertEqual(memory.knn_predict([9.15], 3), 1)
+        self.assertIsNone(ShortTermMemory().knn_predict([0.0], 3))
+
+    def test_stores_copies(self):
+        memory = ShortTermMemory(max_size=2)
+        features = [1.0, 2.0]
+        memory.add(features, 0)
+        features[0] = 99.0
+        self.assertEqual(memory.get_window()[0][0], [1.0, 2.0])
+
+
+class TestLongTermMemory(unittest.TestCase):
+
+    def test_add_and_predict(self):
+        memory = LongTermMemory(max_size=100)
+        for value in (0.0, 0.1, 0.2):
+            memory.add([value], 0)
+        for value in (5.0, 5.1, 5.2):
+            memory.add([value], 1)
+        self.assertEqual(memory.get_size(), 6)
+        self.assertEqual(memory.knn_predict([5.05], 3), 1)
+
+    def test_clean_removes_contradicted_instances(self):
+        memory = LongTermMemory(max_size=100)
+        for value in (0.0, 0.05, 0.1):
+            memory.add([value], 0)      # consistent with the STM below
+        for value in (0.2, 0.25):
+            memory.add([value], 1)      # contradicted: this region is class 0
+        stm_features = [[v] for v in (0.0, 0.02, 0.04, 0.2, 0.22, 0.24)]
+        stm_labels = [0, 0, 0, 0, 0, 0]
+        removed = memory.clean(stm_features, stm_labels, k=3)
+        self.assertEqual(removed, 2)
+        self.assertEqual(memory.get_size(), 3)
+        self.assertEqual(set(memory.labels), {0})
+        self.assertEqual(memory.num_cleaned, 2)
+
+    def test_clean_is_a_noop_without_stm(self):
+        memory = LongTermMemory()
+        memory.add([0.0], 0)
+        self.assertEqual(memory.clean([], [], k=3), 0)
+        self.assertEqual(memory.get_size(), 1)
+
+    def test_compress_creates_prototypes(self):
+        memory = LongTermMemory(max_size=1000, min_cluster_size=2)
+        rng = random.Random(0)
+        for _ in range(30):
+            memory.add([rng.gauss(0.0, 0.1), rng.gauss(0.0, 0.1)], 0)
+        for _ in range(30):
+            memory.add([rng.gauss(5.0, 0.1), rng.gauss(5.0, 0.1)], 1)
+        size_before = memory.get_size()
+        self.assertEqual(memory.num_compressions, 0)
+        removed = memory.compress(target_size=20)
+        self.assertGreater(removed, 0)
+        self.assertLess(memory.get_size(), size_before)
+        self.assertEqual(set(memory.labels), {0, 1})
+        self.assertEqual(memory.num_compressions, 1)
+        # the prototypes still separate the two concepts
+        self.assertEqual(memory.knn_predict([0.0, 0.0], 1), 0)
+        self.assertEqual(memory.knn_predict([5.0, 5.0], 1), 1)
+
+    def test_capacity_is_enforced(self):
+        memory = LongTermMemory(max_size=20, min_cluster_size=2)
+        rng = random.Random(1)
+        for i in range(60):
+            memory.add([rng.random(), rng.random()], i % 2)
+        self.assertLessEqual(memory.get_size(), 20)
+
+
+class TestSAMModel(unittest.TestCase):
+
+    def test_evicted_instances_move_to_ltm(self):
+        model = SAMModel(k=3, stm_max_size=10, ltm_clean_frequency=10 ** 9)
+        for i in range(25):
+            model.partial_fit([i / 25.0], i % 2)
+        sizes = model.get_memory_sizes()
+        self.assertEqual(sizes["stm"], 10)
+        self.assertEqual(sizes["ltm"], 15)
+        self.assertEqual(sizes["total"], 25)
+        self.assertIs(SAMKNN, SAMModel)
+
+    def test_predict_uses_stm_while_it_is_small(self):
+        model = SAMModel(k=1, stm_max_size=5, min_stm_size=50,
+                         ltm_clean_frequency=10 ** 9)
+        for i in range(20):
+            model.partial_fit([float(i)], 0 if i < 10 else 1)
+        details = model.predict_detailed([19.0])
+        self.assertEqual(details["memory"], "STM")
+        self.assertEqual(details["prediction"], 1)
+
+    def test_evaluate_memories_returns_accuracies(self):
+        model = SAMModel(k=3, stm_max_size=50, validation_size=10,
+                         ltm_clean_frequency=10 ** 9)
+        rng = random.Random(2)
+        for _ in range(200):
+            label = rng.randint(0, 1)
+            model.partial_fit([rng.gauss(label * 5.0, 0.5)], label)
+        stm_accuracy, ltm_accuracy = model._evaluate_memories([0.0], 3)
+        self.assertGreaterEqual(stm_accuracy, 0.0)
+        self.assertLessEqual(stm_accuracy, 1.0)
+        self.assertGreaterEqual(ltm_accuracy, 0.0)
+        self.assertLessEqual(ltm_accuracy, 1.0)
+        self.assertGreater(stm_accuracy, 0.8)
+
+    def test_ties_prefer_the_stm(self):
+        model = SAMModel(k=1, stm_max_size=10, min_stm_size=1,
+                         ltm_clean_frequency=10 ** 9)
+        for i in range(20):
+            model.partial_fit([float(i)], 0)
+        model._memory_accuracies = (0.5, 0.5)
+        model._weights_age = model.instances_seen
+        self.assertEqual(model.predict_detailed([5.0])["memory"], "STM")
+
+    def test_accepts_instance_objects(self):
+        from streams import Instance
+        model = SAMModel(k=1, stm_max_size=10)
+        model.partial_fit(Instance([0.0], 1))
+        self.assertEqual(model.predict(Instance([0.0], 1)), 1)
+        model.train(Instance([1.0], 0))
+        self.assertEqual(model.get_memory_sizes()["stm"], 2)
+
+    def test_learns_a_separable_stream(self):
+        model = SAMModel(k=5, stm_max_size=200, ltm_clean_frequency=100)
+        rng = random.Random(4)
+        correct = 0
+        for i in range(1000):
+            label = rng.randint(0, 1)
+            features = [rng.gauss(label * 3.0, 1.0) for _ in range(3)]
+            correct += int(model.predict(features) == label)
+            model.partial_fit(features, label)
+        self.assertGreater(correct / 1000.0, 0.85)
+
+
+class TestSAMExperiment(unittest.TestCase):
+
+    def test_drift_stream_swaps_class_means(self):
+        stream = AbruptDriftStream(seed=1, num_attributes=4, drift_point=100)
+        before = [stream.next_instance() for _ in range(100)]
+        after = [stream.next_instance() for _ in range(100)]
+        mean_before = sum(sum(i.features) / 4 for i in before if i.label == 1) / \
+            max(1, sum(1 for i in before if i.label == 1))
+        mean_after = sum(sum(i.features) / 4 for i in after if i.label == 1) / \
+            max(1, sum(1 for i in after if i.label == 1))
+        self.assertGreater(mean_before, 0.5)
+        self.assertLess(mean_after, 0.5)
+
+    def test_small_experiment_run(self):
+        experiment = SAMKNNExperiment(k=5, stm_size=200, num_instances=1500,
+                                      drift_point=750, tail_size=300)
+        results = experiment.run_all()
+        for key in ("SAM_ACCURACY_STABLE", "SAM_ACCURACY_DRIFT", "SAM_STM_SIZE",
+                    "SAM_LTM_SIZE", "SAM_MEMORY_DECISIONS"):
+            self.assertIn(key, results)
+        self.assertGreater(results["SAM_ACCURACY_STABLE"], 0.5)
+        self.assertGreaterEqual(results["SAM_MEMORY_DECISIONS"], 0.0)
+        self.assertLessEqual(results["SAM_MEMORY_DECISIONS"], 1.0)
+        self.assertGreater(results["SAM_STM_SIZE"], 0.0)
+
+    def test_memory_comparison_reports_three_policies(self):
+        experiment = SAMKNNExperiment(k=5, stm_size=200, num_instances=1500,
+                                      drift_point=750, tail_size=300)
+        comparison = experiment.compare_memories()
+        self.assertEqual(set(comparison),
+                         {"stm_only_accuracy", "ltm_only_accuracy", "sam_accuracy"})
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
