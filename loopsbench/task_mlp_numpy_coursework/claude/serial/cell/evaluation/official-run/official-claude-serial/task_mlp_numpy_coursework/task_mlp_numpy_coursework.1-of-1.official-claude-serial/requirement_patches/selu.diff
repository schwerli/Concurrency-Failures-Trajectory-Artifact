+"""Checks for the SELU layer in `mlp.layers`."""
+
+import numpy as np
+
+from mlp.layers import ELULayer, SELULayer
+
+
+def test_selu_constants_and_delegate():
+    layer = SELULayer()
+    assert np.isclose(layer.alpha, 1.6733, atol=1e-4)
+    assert np.isclose(layer.lamda, 1.0507, atol=1e-4)
+    assert isinstance(layer.elu, ELULayer)
+    assert np.isclose(layer.elu.alpha, layer.alpha)
+
+
+def test_selu_fprop():
+    layer = SELULayer()
+    inputs = np.array([[1., -2.], [-0.5, 3.]])
+    outputs = layer.fprop(inputs)
+    expected = layer.lamda * np.where(
+        inputs > 0., inputs, layer.alpha * (np.exp(inputs) - 1.))
+    assert outputs.shape == inputs.shape
+    assert np.allclose(outputs, expected)
+
+
+def test_selu_bprop_matches_finite_differences():
+    layer = SELULayer()
+    rng = np.random.RandomState(0)
+    inputs = rng.normal(size=(4, 3))
+    grads_wrt_outputs = rng.normal(size=(4, 3))
+    outputs = layer.fprop(inputs)
+    grads_wrt_inputs = layer.bprop(inputs, outputs, grads_wrt_outputs)
+    eps = 1e-6
+    numeric = np.zeros_like(inputs)
+    for idx in np.ndindex(*inputs.shape):
+        pos, neg = inputs.copy(), inputs.copy()
+        pos[idx] += eps
+        neg[idx] -= eps
+        numeric[idx] = ((layer.fprop(pos) - layer.fprop(neg)) *
+                        grads_wrt_outputs).sum() / (2 * eps)
+    assert np.allclose(grads_wrt_inputs, numeric, atol=1e-5)
+
+
+def test_selu_bprop_analytic():
+    layer = SELULayer()
+    inputs = np.array([[2., -1.]])
+    outputs = layer.fprop(inputs)
+    grads = layer.bprop(inputs, outputs, np.ones_like(inputs))
+    expected = layer.lamda * np.array(
+        [[1., layer.alpha * np.exp(-1.)]])
+    assert np.allclose(grads, expected)
+
+
+def test_selu_repr():
+    assert repr(SELULayer()) == 'SELULayer'
