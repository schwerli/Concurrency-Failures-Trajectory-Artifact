+import java.lang.reflect.*;
+import java.util.ArrayList;
+
+public class TestDriver {
+    @SuppressWarnings("unchecked")
+    public static void main(String[] args) throws Exception {
+        Class<?> mainCls = Class.forName("Main");
+        Class<?> nodeCls = Class.forName("NodeType");
+
+        Method insert = mainCls.getDeclaredMethod("insertBST", nodeCls, nodeCls, int.class);
+        Method search = mainCls.getDeclaredMethod("searchBST", nodeCls, int.class);
+        Method sort = mainCls.getDeclaredMethod("sortBST", nodeCls);
+        Method delete = mainCls.getDeclaredMethod("deleteBST", nodeCls, int.class);
+        Method setRecord = nodeCls.getDeclaredMethod("setRecord", int.class);
+        insert.setAccessible(true); search.setAccessible(true);
+        sort.setAccessible(true); delete.setAccessible(true); setRecord.setAccessible(true);
+
+        Field allElements = mainCls.getDeclaredField("allElements");
+        allElements.setAccessible(true);
+        allElements.set(null, new ArrayList<Integer>());
+        ArrayList<Integer> list = (ArrayList<Integer>) allElements.get(null);
+
+        Field tempTimes = mainCls.getDeclaredField("tempTimes");
+        tempTimes.setAccessible(true);
+
+        // build a small tree: 50, 30, 70, 20, 40, 60, 80
+        Object root = nodeCls.getDeclaredConstructor().newInstance();
+        setRecord.invoke(root, 50);
+        int[] vals = {30, 70, 20, 40, 60, 80};
+        for (int v : vals) insert.invoke(null, root, null, v);
+
+        // sortBST appends in-order to allElements
+        list.clear();
+        sort.invoke(null, root);
+        assertEq(list.toString(), "[20, 30, 40, 50, 60, 70, 80]", "sortBST in-order");
+
+        // searchBST: found -> 1, comparisons in tempTimes (depth of node)
+        assertEq(search.invoke(null, root, 50), 1, "search root");
+        assertEq(tempTimes.get(null), 1, "comparisons root");
+        assertEq(search.invoke(null, root, 20), 1, "search leaf");
+        assertEq(tempTimes.get(null), 3, "comparisons leaf");
+        assertEq(search.invoke(null, root, 999), 0, "search absent");
+        assertEq(tempTimes.get(null), 3, "comparisons absent");
+
+        // deleteBST leaf, one-child, two-children (deletemin path)
+        delete.invoke(null, root, 20);
+        list.clear(); sort.invoke(null, root);
+        assertEq(list.toString(), "[30, 40, 50, 60, 70, 80]", "delete leaf 20");
+
+        delete.invoke(null, root, 70); // two children -> deletemin(80 subtree)= 80? right subtree of 70 is 80 only
+        list.clear(); sort.invoke(null, root);
+        assertEq(list.toString(), "[30, 40, 50, 60, 80]", "delete two-child 70");
+
+        delete.invoke(null, root, 50); // root with two children
+        list.clear(); sort.invoke(null, root);
+        assertEq(list.toString(), "[30, 40, 60, 80]", "delete root 50");
+
+        delete.invoke(null, root, 999); // absent, must not corrupt
+        list.clear(); sort.invoke(null, root);
+        assertEq(list.toString(), "[30, 40, 60, 80]", "delete absent");
+
+        // insert after delete
+        insert.invoke(null, root, null, 55);
+        list.clear(); sort.invoke(null, root);
+        assertEq(list.toString(), "[30, 40, 55, 60, 80]", "insert 55 after deletes");
+
+        System.out.println("ALL TESTS PASSED");
+    }
+
+    private static void assertEq(Object actual, Object expected, String label) {
+        if (!String.valueOf(actual).equals(String.valueOf(expected)))
+            throw new AssertionError(label + ": expected=" + expected + " actual=" + actual);
+        System.out.println("OK " + label + " -> " + actual);
+    }
+}
