{"parentUuid":"bfbe0eaa-1a90-426b-b190-7e38abc38dd9","isSidechain":true,"promptId":"5297eeb9-1c2b-4852-b5a3-118b99e5e68d","agentId":"ab1cdf45c4c617460","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01KuvsfVvvGaFnL114JNLnMG","type":"tool_result","content":"    PTE *pgtable = user_page[pa2num(pa)].pgtable;\n    if(pgtable != NULL){\n        clear_attribute(pgtable, _PAGE_PRESENT);\n        set_attribute(pgtable, _PAGE_SOFT);\n        set_pfn(pgtable, (uint64_t)i);\n    }\n\n    flush_tlb_all();\n    free_user_page(pa);\n}\n\nunsigned long free_page_num()\n{\n    unsigned long ret = 0;\n    for(int i = 0; i < USER_PAGE_NUM; i++){\n        if(user_page[i].valid == 0){\n            ret++;\n        }\n    }\n    return ret;\n}\n\n/* Walk the three levels of `pgdir` (a pa) down to the leaf entry for `va`,\n * creating the intermediate tables on the way. Returns a pointer to the leaf\n * PTE, which the caller reaches through the kernel's direct mapping. */\nstatic PTE* walk_pgdir(uintptr_t va, uintptr_t pgdir)\n{\n    uint64_t vpn[3];\n    vpn[2] = (va >> VPN2_SHIFT) & VPN_MASK;\n    vpn[1] = (va >> VPN1_SHIFT) & VPN_MASK;\n    vpn[0] = (va >> VPN0_SHIFT) & VPN_MASK;\n\n    PTE *table = (PTE*)pa2kva(pgdir);\n    for(int level = 2; level > 0; level--){\n        PTE *entry = table + vpn[level];\n        if(!get_attribute(*entry, _PAGE_PRESENT)){\n            PTE *next = alloc_pgdir_page();\n            *entry = 0;\n            set_pfn(entry, (uintptr_t)next >> NORMAL_PAGE_SHIFT);\n            /* a pointer entry carries no R/W/X bits */\n            set_attribute(entry, _PAGE_PRESENT);\n        }\n        table = (PTE*)pa2kva(get_pa(*entry));\n    }\n    return table + vpn[0];\n}\n\n/* Same walk, but without creating anything: returns NULL when the address is\n * not backed by a leaf entry at all. */\nPTE* find_pte(uintptr_t va, uintptr_t pgdir)\n{\n    uint64_t vpn[3];\n    vpn[2] = (va >> VPN2_SHIFT) & VPN_MASK;\n    vpn[1] = (va >> VPN1_SHIFT) & VPN_MASK;\n    vpn[0] = (va >> VPN0_SHIFT) & VPN_MASK;\n\n    PTE *table = (PTE*)pa2kva(pgdir);\n    for(int level = 2; level > 0; level--){\n        PTE *entry = table + vpn[level];\n        if(!get_attribute(*entry, _PAGE_PRESENT)){\n            return NULL;\n        }\n        table = (PTE*)pa2kva(get_pa(*entry));\n    }\n    return table + vpn[0];\n}\n\n/*\n * Make sure `va` is backed by a physical frame in `pgdir` (a pa) and return\n * the kernel virtual address of that frame.  A page that had been swapped out\n * is read back from the SD card first.  The signature matches the callback\n * load_elf() expects, so it doubles as the \"prepare page\" hook of do_exec().\n */\nuintptr_t alloc_page_helper(uintptr_t va, uintptr_t pgdir)\n{\n    va = ROUNDDOWN(va, PAGE_SIZE);\n    PTE *pte = walk_pgdir(va, pgdir);\n\n    if(!get_attribute(*pte, _PAGE_PRESENT)){\n        if(get_attribute(*pte, _PAGE_SOFT)){\n            /* the page lives in the swap area, fetch it back */\n            uint64_t slot = get_pfn(*pte);\n            uintptr_t pa = alloc_user_page(0, pte);\n            sbi_sd_read((unsigned int)pa, PAGE_SD_BLOCKS, SWAP_BEGIN + slot * PAGE_SD_BLOCKS);\n            disk_page[slot].valid = 0;\n            *pte = 0;\n            set_pfn(pte, pa >> NORMAL_PAGE_SHIFT);\n        }\n        else{\n            uintptr_t pa = alloc_user_page(0, pte);\n            *pte = 0;\n            set_pfn(pte, pa >> NORMAL_PAGE_SHIFT);\n        }\n        set_attribute(pte, _PAGE_PRESENT | _PAGE_READ | _PAGE_WRITE | _PAGE_EXEC |\n                           _PAGE_USER | _PAGE_ACCESSED | _PAGE_DIRTY);\n        flush_tlb_all();\n    }\n\n    return pa2kva(get_pa(*pte));\n}\n\n/*\n * Virtual Memory Layout\n * 0x0_0000_1000 ~ 0x0_0001_0000: share\n * 0x0_0001_0000 ~ 0x0_0001_3000: code\n * 0xf_0000_f000 ~ 0xf_0001_0000: stack\n */\nPTE* init_page_table()\n{\n    PTE *pgdir = alloc_pgdir_page();\n    PTE *pgdir_kva = (PTE*)pa2kva((uintptr_t)pgdir);\n    PTE *kernel_pgdir_kva = (PTE*)pa2kva(PGDIR_PA);\n\n    /* Every address space keeps the kernel mapped: VPN2 of the kernel window\n     * 0xffffffc0_00000000 is 0x101 and boot.c installed it there. */\n    pgdir_kva[0x101] = kernel_pgdir_kva[0x101];\n\n    /* init_pcb() resolves addresses with get_kva_of(), which only walks the\n     * table, so the whole code region has to be mapped up front. */\n    for(uintptr_t va = USER_CODE_BEGIN; va < USER_CODE_END; va += PAGE_SIZE){\n        alloc_page_helper(va, (uintptr_t)pgdir);\n    }\n    /* and one page of user stack to start on */\n    alloc_page_helper(USER_STACK_ADDR - PAGE_SIZE, (uintptr_t)pgdir);\n\n    return pgdir;\n}\n\nvoid free_process_user_page(PTE* pgdir)\n{\n    if(pgdir == NULL || (uintptr_t)pgdir == PGDIR_PA){\n        return;\n    }\n\n    PTE *pgdir_kva = (PTE*)pa2kva((uintptr_t)pgdir);\n\n    /* Only the user half is owned by this process; VPN2 >= 0x100 belongs to\n     * the kernel window, which is shared by everybody. */\n    for(int vpn2 = 0; vpn2 < NUM_PTE_ENTRY / 2; vpn2++){\n        if(!get_attribute(pgdir_kva[vpn2], _PAGE_PRESENT)){\n            continue;\n        }\n        uintptr_t second_pa = get_pa(pgdir_kva[vpn2]);\n        PTE *second_kva = (PTE*)pa2kva(second_pa);\n\n        for(int vpn1 = 0; vpn1 < NUM_PTE_ENTRY; vpn1++){\n            if(!get_attribute(second_kva[vpn1], _PAGE_PRESENT)){\n                continue;\n            }\n            uintptr_t third_pa = get_pa(second_kva[vpn1]);\n            PTE *third_kva = (PTE*)pa2kva(third_pa);\n\n            for(int vpn0 = 0; vpn0 < NUM_PTE_ENTRY; vpn0++){\n                PTE leaf = third_kva[vpn0];\n                if(leaf == 0){\n                    continue;\n                }\n                if(get_attribute(leaf, _PAGE_PRESENT)){\n                    uintptr_t pa = get_pa(leaf);\n                    int shared = 0;\n                    /* a shared page only goes away with its last user */\n                    for(int k = 0; k < SHM_PAGE_NUM; k++){\n                        if(shm_page[k].count > 0 && shm_page[k].pa == pa){\n                            shm_page[k].count--;\n                            if(shm_page[k].count == 0){\n                                free_user_page(pa);\n                                shm_page[k].pa = 0;\n                            }\n                            shared = 1;\n                            break;\n                        }\n                    }\n                    if(!shared){\n                        free_user_page(pa);\n                    }\n                }\n                else if(get_attribute(leaf, _PAGE_SOFT)){\n                    /* the page was swapped out, give the disk slot back */\n                    disk_page[get_pfn(leaf)].valid = 0;\n                }\n                third_kva[vpn0] = 0;\n            }\n\n            free_pgdir_page(third_pa);\n            second_kva[vpn1] = 0;\n        }\n\n        free_pgdir_page(second_pa);\n        pgdir_kva[vpn2] = 0;\n    }\n\n    free_pgdir_page((uintptr_t)pgdir);\n    flush_tlb_all();\n}\n\nuintptr_t shm_page_get(int key)\n{\n    shm_page_t *page = &shm_page[(uint32_t)key % SHM_PAGE_NUM];\n\n    if(page->count == 0){\n        /* first user of this key: give the group a pinned frame, it must\n         * never be swapped out behind the back of the other sharers */\n        page->pa = alloc_user_page(1, NULL);\n    }\n\n    uintptr_t pgdir = (uintptr_t)current_running[cpu_id]->pgdir;\n    for(uintptr_t va = SHM_VA_BEGIN; va < SHM_VA_END; va += PAGE_SIZE){\n        PTE *pte = walk_pgdir(va, pgdir);\n        if(get_attribute(*pte, _PAGE_PRESENT) || get_attribute(*pte, _PAGE_SOFT)){\n            continue;\n        }\n        *pte = 0;\n        set_pfn(pte, page->pa >> NORMAL_PAGE_SHIFT);\n        set_attribute(pte, _PAGE_PRESENT | _PAGE_READ | _PAGE_WRITE |\n                           _PAGE_USER | _PAGE_ACCESSED | _PAGE_DIRTY);\n        page->count++;\n        flush_tlb_all();\n        return va;\n    }\n\n    /* the share window of this process is full */\n    if(page->count == 0){\n        free_user_page(page->pa);\n        page->pa = 0;\n    }\n    return 0;\n}\n\nvoid shm_page_dt(uintptr_t addr)\n{\n    uintptr_t pgdir = (uintptr_t)current_running[cpu_id]->pgdir;\n    PTE *pte = find_pte(ROUNDDOWN(addr, PAGE_SIZE), pgdir);\n\n    if(pte == NULL || !get_attribute(*pte, _PAGE_PRESENT)){\n        return;\n    }\n\n    /* only a page that really belongs to a share group may be detached,\n     * otherwise a bogus address would silently unmap private memory */\n    uintptr_t pa = get_pa(*pte);\n    for(int i = 0; i < SHM_PAGE_NUM; i++){\n        if(shm_page[i].count > 0 && shm_page[i].pa == pa){\n            *pte = 0;\n            flush_tlb_all();\n\n            shm_page[i].count--;\n            if(shm_page[i].count == 0){\n                free_user_page(pa);\n                shm_page[i].pa = 0;\n            }\n            return;\n        }\n    }\n}\n\nvoid handle_page_fault(regs_context_t *regs, uint64_t stval, uint64_t cause)\n{\n    /* Anything outside the user half of the Sv39 address space is a genuine\n     * kernel bug; let the generic handler dump the context. */\n    if(stval >= (1lu << (VPN2_SHIFT + PPN_BITS - 1))){\n        handle_other(regs, stval, cause);\n        return;\n    }\n\n    /* demand paging: give the faulting address a frame (or fetch it back\n     * from the swap area) and let the instruction run again */\n    alloc_page_helper(stval, (uintptr_t)current_running[cpu_id]->pgdir);\n}","is_error":false}]},"uuid":"051c745d-050e-4ac7-b174-c6638ceea718","timestamp":"2026-08-14T14:03:45.305Z","sourceToolAssistantUUID":"bfbe0eaa-1a90-426b-b190-7e38abc38dd9","userType":"external","entrypoint":"sdk-cli","cwd":"/workspace/Project6-File_System","sessionId":"d6f8a297-7d8a-4992-a1a5-9ad03cc06e48","version":"2.1.207","gitBranch":"master"}
