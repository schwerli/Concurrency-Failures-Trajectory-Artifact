{"parentUuid":"669397ca-fe08-4b3d-999c-dbe9c127b90a","isSidechain":true,"promptId":"5297eeb9-1c2b-4852-b5a3-118b99e5e68d","agentId":"ab1cdf45c4c617460","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_01M7fdzqBrnGFKcNW6Yy25gF","type":"tool_result","content":"407 kernel/mm/mm.c\n#include <os/list.h>\n#include <os/mm.h>\n#include <os/sched.h>\n#include <pgtable.h>\n#include <os/string.h>\n#include <os/sched.h>\n#include <os/irq.h>\n#include <assert.h>\n\nptr_t kernel_memCurr = KERNEL_MEM_BEGIN;\nptr_t user_memCurr = USER_MEM_BEGIN;\n\nuser_page_t user_page[USER_PAGE_NUM];\nshm_page_t shm_page[SHM_PAGE_NUM];\ndisk_page_t disk_page[DISK_PAGE_NUM];\npgdir_page_t pgdir_page[PGDIR_PAGE_NUM];\n\n// returns pa\nPTE* alloc_pgdir_page()\n{\n    int i;\n    for(i = 0; i < PGDIR_PAGE_NUM; i++){\n        if(pgdir_page[i].valid == 0){\n            break;\n        }\n    }\n    assert(i != PGDIR_PAGE_NUM);\n    pgdir_page[i].valid = 1;\n    PTE *ret = (PTE*)(FREE_PGDIR_ADDR + i * PAGE_SIZE);\n    clear_pgdir((PTE*)pa2kva((uintptr_t)ret));\n    return ret;\n}\n\nvoid free_pgdir_page(uintptr_t addr)\n{\n    int i = (addr - FREE_PGDIR_ADDR) / PAGE_SIZE;\n    pgdir_page[i].valid = 0;\n}\n\nint pa2num(uintptr_t pa)\n{\n    return (pa - USER_MEM_BEGIN) / PAGE_SIZE;\n}\nptr_t num2pa(int num)\n{\n    return (USER_MEM_BEGIN + num * PAGE_SIZE);\n}\n\n// returns pa\nptr_t alloc_user_page(uint8_t pin, PTE* pgtable)\n{\n    int i;\n    for(i = 0; i < USER_PAGE_NUM; i++){\n        if(user_page[i].valid == 0){\n            break;\n        }\n    }\n\n    ptr_t pa;\n    if(i == USER_PAGE_NUM){\n        /* physical memory is exhausted: swap somebody else out first */\n        pa = selete_page();\n        write_to_sd(pa);\n        i = pa2num(pa);\n    }\n    else{\n        pa = num2pa(i);\n    }\n\n    user_page[i].valid = 1;\n    user_page[i].pin = pin;\n    user_page[i].pgtable = pgtable;\n\n    /* a fresh page must not leak the previous owner's data */\n    memset((void*)pa2kva(pa), 0, PAGE_SIZE);\n    return pa;\n}\n\n// baseAddr is pa\nvoid free_user_page(ptr_t baseAddr)\n{\n    user_page[pa2num(baseAddr)].valid = 0;\n}\n\n// returns pa\nvoid *kmalloc(size_t size)\n{\n    // align 4\n    ptr_t ret = ROUND(kernel_memCurr, 4);\n    kernel_memCurr = ret + size;\n    return (void*)ret;\n}\n\n// select a user page to write to disk (NRU), returns pa\nptr_t selete_page()\n{\n    /* Not Recently Used with a second chance: sweep the frames, give every\n     * page whose accessed bit is set one more round (clearing the bit as we\n     * pass by), and evict the first one that survived a whole sweep unused.\n     * Pinned frames (kernel stacks, shared pages) and frames that are not\n     * reachable through a page table entry can never be evicted. */\n    static int clock_hand = 0;\n\n    for(int step = 0; step < 2 * USER_PAGE_NUM; step++){\n        int i = clock_hand;\n        clock_hand = (clock_hand + 1) % USER_PAGE_NUM;\n\n        if(!user_page[i].valid || user_page[i].pin || user_page[i].pgtable == NULL){\n            continue;\n        }\n        if(get_attribute(*user_page[i].pgtable, _PAGE_ACCESSED)){\n            clear_attribute(user_page[i].pgtable, _PAGE_ACCESSED);\n            continue;\n        }\n        return num2pa(i);\n    }\n\n    /* every single frame is pinned, there is nothing we can do */\n    assert(0);\n    return 0;\n}\n\nvoid write_to_sd(ptr_t pa)\n{\n    int i;\n    for(i = 0; i < DISK_PAGE_NUM; i++){\n        if(disk_page[i].valid == 0){\n            break;\n        }\n    }\n    assert(i != DISK_PAGE_NUM);\n    disk_page[i].valid = 1;\n\n    sbi_sd_write((unsigned int)pa, PAGE_SD_BLOCKS, SWAP_BEGIN + i * PAGE_SD_BLOCKS);\n\n    /* Remember where the page went inside its own page table entry: the\n     * frame number field now holds the swap slot and _PAGE_SOFT marks the\n     * entry as \"on disk\" so that the page fault handler can tell it apart\n     * from a never-mapped address. */\n    PTE *pgtable = user_page[pa2num(pa)].pgtable;","is_error":false}]},"uuid":"81b90bc1-f290-44d1-a47f-8bc8e95c2e17","timestamp":"2026-08-14T14:03:37.925Z","sourceToolAssistantUUID":"669397ca-fe08-4b3d-999c-dbe9c127b90a","userType":"external","entrypoint":"sdk-cli","cwd":"/workspace/Project6-File_System","sessionId":"d6f8a297-7d8a-4992-a1a5-9ad03cc06e48","version":"2.1.207","gitBranch":"master"}
