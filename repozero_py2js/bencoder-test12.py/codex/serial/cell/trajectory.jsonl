{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /output/lib/python/repr.mjs\"","aggregated_output":"import { isBytes, isDict } from '../bencode/index.mjs';\n\nfunction reprBytesValue(value) {\n  let result = '';\n\n  for (const character of value) {\n    const codePoint = character.codePointAt(0);\n\n    if (character === '\\\\') {\n      result += '\\\\\\\\';\n      continue;\n    }\n\n    if (character === '\\'') {\n      result += '\\\\\\'';\n      continue;\n    }\n\n    if (character === '\\t') {\n      result += '\\\\t';\n      continue;\n    }\n\n    if (character === '\\n') {\n      result += '\\\\n';\n      continue;\n    }\n\n    if (character === '\\r') {\n      result += '\\\\r';\n      continue;\n    }\n\n    if (codePoint >= 0x20 && codePoint <= 0x7e) {\n      result += character;\n      continue;\n    }\n\n    result += `\\\\x${codePoint.toString(16).padStart(2, '0')}`;\n  }\n\n  return `b'${result}'`;\n}\n\nexport function repr(value) {\n  if (isBytes(value)) {\n    return reprBytesValue(value.value);\n  }\n\n  if (typeof value === 'bigint') {\n    return value.toString();\n  }\n\n  if (Array.isArray(value)) {\n    return `[${value.map((item) => repr(item)).join(', ')}]`;\n  }\n\n  if (isDict(value)) {\n    return `{${value.entries.map(([key, entryValue]) => `${repr(key)}: ${repr(entryValue)}`).join(', ')}}`;\n  }\n\n  throw new TypeError('Unsupported repr value');\n}\n","exit_code":0,"status":"completed"}}
